# ==============================================================================
# .gitignore - Astro Project (Secretaría de Planeamiento UNLu)
# ==============================================================================

# ─── 1. Dependencias ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.pnpm-store/

# ─── 2. Salida de compilación & Hosting (Astro / Vercel / Vite) ───────────────
dist/
.output/
.astro/
.vercel/
.turbo/
.cache/

# ─── 3. Variables de entorno y secretos ───────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
*.env.local

# Permitir explícitamente las plantillas públicas
!.env.example
!.env.template

# ─── 4. Logs y depuración ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── 5. Editores e IDEs ───────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
*.swp

# ─── 6. Sistema operativo ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
[Dd]esktop.ini
$RECYCLE.BIN/

# ─── 7. Temporales y backups ──────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.orig
*~
