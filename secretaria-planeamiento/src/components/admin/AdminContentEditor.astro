window.addChildSubBlock = function(parentIdx, type) {
  if (!currentBlocks[parentIdx].children) currentBlocks[parentIdx].children = [];
  const newChild = {
    id: generateId(),
    type: type,
    props: {}
  };
  if (type === 'texto-rico') newChild.props.contenido = '<p>Nuevo párrafo de texto...</p>';
  if (type === 'titulo-bloque') { newChild.props.texto = 'Nuevo Título'; newChild.props.nivel = 'h2'; }
  if (type === 'lista-puntos') newChild.props.items = 'Elemento 1\nElemento 2';
  if (type === 'link-card') { newChild.props.text = 'Concluimos el análisis de las encuestas realizadas y lo compartimos'; newChild.props.url = '#'; }
  if (type === 'cta-banner') { newChild.props.etiqueta = 'DOCUMENTO'; newChild.props.titulo = 'Título del documento'; newChild.props.url = '#'; newChild.props.textoBoton = 'Acceder'; }

  currentBlocks[parentIdx].children.push(newChild);
  renderBlockList();
};

window.moveChildSubBlock = function(parentIdx, childIdx, dir) {
  const children = currentBlocks[parentIdx].children;
  if (!children) return;
  const newIdx = childIdx + dir;
  if (newIdx < 0 || newIdx >= children.length) return;
  const tmp = children[childIdx];
  children[childIdx] = children[newIdx];
  children[newIdx] = tmp;
  renderBlockList();
};

window.deleteChildSubBlock = function(parentIdx, childIdx) {
  if (!confirm('¿Eliminar este bloque interno?')) return;
  currentBlocks[parentIdx].children.splice(childIdx, 1);
  renderBlockList();
};

function renderInlineFieldsForBlock(block, idx) {
  const def = getBlockDef(block.type);
  if(!def || !def.fields || def.fields.length === 0) return '';
  const props = block.props || {};

  // Campos superiores del bloque principal
  const fieldsHtml = def.fields.map(field => {
    // Si la sección tiene sub-bloques, omitir el campo genérico "contenido" único
    if (block.type === 'seccion-badge' && field.key === 'contenido' && Array.isArray(block.children) && block.children.length > 0) {
      return '';
    }

    const val = props[field.key] !== undefined ? props[field.key] : (field.default||'');
    const fieldId = `inline-field-${idx}-${field.key}`;

    if(field.type === 'wysiwyg' || field.type === 'richtext') {
      return `<div class="space-y-1.5 mt-3">
        <label class="block text-xs font-bold text-slate-700">${field.label}</label>
        <div class="border border-slate-300 rounded-2xl overflow-hidden bg-white shadow-2xs">
          <!-- BARRA WORD EN LÍNEA EN LA TARJETA -->
          <div class="flex flex-wrap items-center gap-1 px-3 py-2 bg-slate-100 border-b border-slate-200 text-slate-700 select-none">
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'bold')" class="px-2.5 py-1 rounded-lg hover:bg-slate-200 font-bold text-xs cursor-pointer active:scale-95" title="Negrita (Ctrl+B)">B</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'italic')" class="px-2.5 py-1 rounded-lg hover:bg-slate-200 italic font-serif text-xs cursor-pointer active:scale-95" title="Cursiva (Ctrl+I)">I</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'underline')" class="px-2.5 py-1 rounded-lg hover:bg-slate-200 underline text-xs cursor-pointer active:scale-95" title="Subrayado (Ctrl+U)">U</button>
            <div class="h-4 w-px bg-slate-300 mx-1"></div>
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'formatBlock', '<h3>')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs font-bold text-slate-800 cursor-pointer active:scale-95" title="Título H2">H2</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'formatBlock', '<h4>')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs font-bold text-slate-600 cursor-pointer active:scale-95" title="Subtítulo H3">H3</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'formatBlock', '<p>')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs text-slate-600 cursor-pointer active:scale-95" title="Párrafo normal">Párrafo</button>
            <div class="h-4 w-px bg-slate-300 mx-1"></div>
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'insertUnorderedList')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs font-bold cursor-pointer active:scale-95" title="Lista con viñetas">• Lista</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'insertOrderedList')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs font-bold cursor-pointer active:scale-95" title="Lista numerada">1. Lista</button>
            <div class="h-4 w-px bg-slate-300 mx-1"></div>
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'toggleGreen')" class="px-2 py-1 rounded-lg bg-emerald-100 hover:bg-emerald-200 text-unlu-green font-bold text-xs flex items-center gap-1 cursor-pointer active:scale-95" title="Activar/Desactivar Texto Verde">✨ Texto Verde</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'createLink')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs font-bold text-blue-700 cursor-pointer active:scale-95" title="Insertar Enlace">🔗 Enlace</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execInlineCmd('${fieldId}', ${idx}, '${field.key}', 'removeFormat')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs text-slate-400 cursor-pointer active:scale-95" title="Limpiar formato">🧹 Limpiar</button>
          </div>
          <!-- ÁREA CONTENTEDITABLE EN LÍNEA -->
          <div id="${fieldId}" contenteditable="true" oninput="updateBlockProp(${idx}, '${field.key}', this.innerHTML)" class="p-4 min-h-[160px] text-sm leading-relaxed text-slate-800 focus:outline-none bg-white">${val}</div>
        </div>
      </div>`;
    }

    if(field.type === 'textarea') {
      return `<div class="space-y-1 mt-3">
        <label class="block text-xs font-bold text-slate-700">${field.label}</label>
        <textarea oninput="updateBlockProp(${idx}, '${field.key}', this.value)" class="w-full border border-slate-300 rounded-xl p-3 text-xs font-sans text-slate-800 focus:outline-none focus:ring-2 focus:ring-unlu-green resize-y min-h-[100px]" placeholder="${field.placeholder||''}">${val}</textarea>
      </div>`;
    }

    if(field.type === 'select') {
      const opts = (field.options||[]).map(o => `<option value="${o.value}" ${val===o.value?'selected':''}>${o.label}</option>`).join('');
      return `<div class="space-y-1 mt-3">
        <label class="block text-xs font-bold text-slate-700">${field.label}</label>
        <select onchange="updateBlockProp(${idx}, '${field.key}', this.value)" class="w-full border border-slate-300 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-unlu-green bg-white">${opts}</select>
      </div>`;
    }

    return `<div class="space-y-1 mt-3">
      <label class="block text-xs font-bold text-slate-700">${field.label}</label>
      <input type="${field.type||'text'}" value="${(val+'').replace(/"/g,'&quot;')}" oninput="updateBlockProp(${idx}, '${field.key}', this.value)" class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-unlu-green" placeholder="${field.placeholder||''}" />
