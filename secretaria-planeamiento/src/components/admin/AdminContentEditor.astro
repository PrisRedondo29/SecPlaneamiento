      <div class="space-y-3">
        ${children.map((child, cIdx) => {
          const cDef = getBlockDef(child.type);
          const cIcon = cDef ? cDef.icon : '📌';
          const cName = cDef ? cDef.name : child.type;
          const cProps = child.props || {};
          const childFieldId = `child-field-${idx}-${cIdx}`;

          let childInputHtml = '';
          if (child.type === 'texto-rico' || cDef?.fields?.some(f=>f.type==='wysiwyg')) {
            const contentVal = cProps.contenido || '';
            childInputHtml = `<div class="border border-slate-300 rounded-xl overflow-hidden bg-white mt-2 shadow-2xs">
              <div class="flex flex-wrap items-center gap-1 px-2.5 py-1.5 bg-slate-100 border-b border-slate-200 text-slate-700 select-none">
                <button type="button" onmousedown="event.preventDefault()" onclick="execChildCmd('${childFieldId}', ${idx}, ${cIdx}, 'contenido', 'bold')" class="px-2 py-0.5 rounded font-bold text-xs hover:bg-slate-200">B</button>
                <button type="button" onmousedown="event.preventDefault()" onclick="execChildCmd('${childFieldId}', ${idx}, ${cIdx}, 'contenido', 'italic')" class="px-2 py-0.5 rounded italic font-serif text-xs hover:bg-slate-200">I</button>
                <button type="button" onmousedown="event.preventDefault()" onclick="execChildCmd('${childFieldId}', ${idx}, ${cIdx}, 'contenido', 'underline')" class="px-2 py-0.5 rounded underline text-xs hover:bg-slate-200">U</button>
                <div class="h-3.5 w-px bg-slate-300 mx-1"></div>
                <button type="button" onmousedown="event.preventDefault()" onclick="execChildCmd('${childFieldId}', ${idx}, ${cIdx}, 'contenido', 'insertUnorderedList')" class="px-2 py-0.5 rounded font-bold text-xs hover:bg-slate-200">• Lista</button>
                <button type="button" onmousedown="event.preventDefault()" onclick="execChildCmd('${childFieldId}', ${idx}, ${cIdx}, 'contenido', 'insertOrderedList')" class="px-2 py-0.5 rounded font-bold text-xs hover:bg-slate-200">1. Lista</button>
                <div class="h-3.5 w-px bg-slate-300 mx-1"></div>
                <button type="button" onmousedown="event.preventDefault()" onclick="execChildCmd('${childFieldId}', ${idx}, ${cIdx}, 'contenido', 'toggleGreen')" class="px-2 py-0.5 rounded bg-emerald-100 text-unlu-green font-bold text-xs hover:bg-emerald-200">✨ Texto Verde</button>
                <button type="button" onmousedown="event.preventDefault()" onclick="execChildCmd('${childFieldId}', ${idx}, ${cIdx}, 'contenido', 'createLink')" class="px-2 py-0.5 rounded text-blue-700 font-bold text-xs hover:bg-slate-200">🔗 Enlace</button>
              </div>
              <div id="${childFieldId}" contenteditable="true" oninput="updateChildProp(${idx}, ${cIdx}, 'contenido', this.innerHTML)" class="p-3 min-h-[100px] text-xs leading-relaxed text-slate-800 focus:outline-none bg-white">${contentVal}</div>
            </div>`;
          } else if (child.type === 'titulo-bloque') {
            childInputHtml = `<div class="grid grid-cols-1 sm:grid-cols-4 gap-2 mt-2">
              <input type="text" value="${(cProps.texto||'').replace(/"/g,'&quot;')}" oninput="updateChildProp(${idx}, ${cIdx}, 'texto', this.value)" placeholder="Texto del título..." class="sm:col-span-3 border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-unlu-green" />
              <select onchange="updateChildProp(${idx}, ${cIdx}, 'nivel', this.value)" class="border border-slate-300 rounded-lg px-2 py-1.5 text-xs font-semibold text-slate-800 bg-white">
                <option value="h2" ${cProps.nivel!=='h3'?'selected':''}>Título H2</option>
                <option value="h3" ${cProps.nivel==='h3'?'selected':''}>Subtítulo H3</option>
              </select>
            </div>`;
          } else if (child.type === 'lista-puntos') {
            childInputHtml = `<div class="mt-2">
              <textarea oninput="updateChildProp(${idx}, ${cIdx}, 'items', this.value)" placeholder="Un elemento por línea..." class="w-full border border-slate-300 rounded-lg p-2.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-unlu-green min-h-[80px]">${cProps.items||''}</textarea>
            </div>`;
          } else if (child.type === 'link-card') {
            childInputHtml = `<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2">
              <input type="text" value="${(cProps.text||'').replace(/"/g,'&quot;')}" oninput="updateChildProp(${idx}, ${cIdx}, 'text', this.value)" placeholder="Texto del enlace..." class="sm:col-span-2 border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-unlu-green" />
              <input type="url" value="${(cProps.url||'').replace(/"/g,'&quot;')}" oninput="updateChildProp(${idx}, ${cIdx}, 'url', this.value)" placeholder="URL..." class="sm:col-span-2 border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-unlu-green" />
            </div>`;
          } else if (child.type === 'cta-banner') {
            childInputHtml = `<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2">
              <input type="text" value="${(cProps.etiqueta||'').replace(/"/g,'&quot;')}" oninput="updateChildProp(${idx}, ${cIdx}, 'etiqueta', this.value)" placeholder="Etiqueta..." class="border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs" />
              <input type="text" value="${(cProps.textoBoton||'').replace(/"/g,'&quot;')}" oninput="updateChildProp(${idx}, ${cIdx}, 'textoBoton', this.value)" placeholder="Texto botón..." class="border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs" />
              <input type="text" value="${(cProps.titulo||'').replace(/"/g,'&quot;')}" oninput="updateChildProp(${idx}, ${cIdx}, 'titulo', this.value)" placeholder="Título..." class="sm:col-span-2 border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs" />
              <input type="url" value="${(cProps.url||'').replace(/"/g,'&quot;')}" oninput="updateChildProp(${idx}, ${cIdx}, 'url', this.value)" placeholder="URL..." class="sm:col-span-2 border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs" />
            </div>`;
          }

          return `<div class="bg-slate-50 border border-slate-200 rounded-xl p-3 relative group/child">
            <div class="flex items-center justify-between pb-1.5 border-b border-slate-200">
              <div class="flex items-center gap-1.5">
