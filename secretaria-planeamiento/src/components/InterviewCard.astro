---
/**
 * Componente: InterviewCard
 * Replicado según el prototipo: una caja simple con fondo blanco, borde gris,
 * y un icono de descarga/documento rojo a la izquierda.
 */
interface Props {
  title: string;
  href?: string;
}

const {
  title,
  href = "#"
} = Astro.props;
---

<a
  href={href}
  class="flex items-center gap-3.5 p-4 bg-white border border-gray-200 rounded-lg hover:shadow-xs hover:border-unlu-red/40 transition-all group"
>
  <!-- Icono de documento/descarga en color rojo institucional UNLu (#b62d2e) -->
  <div class="shrink-0 text-unlu-red">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
  </div>
  
  <!-- Título del documento/entrevista -->
  <span class="text-sm font-medium text-gray-700 group-hover:text-unlu-red transition-colors leading-snug">
    {title}
  </span>
</a>
