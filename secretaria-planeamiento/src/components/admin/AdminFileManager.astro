---
/**
 * Componente: AdminFileManager
 * Explorador de Documentos y Archivos Multimedia.
 * Totalmente funcional localmente con filtrado, búsqueda, vista previa y eliminación.
 */
---

<div class="space-y-6">
  <!-- Header de la Sección -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
        <a href="/admin" class="hover:text-unlu-green">Dashboard</a>
        <span>/</span>
        <span class="text-slate-900 font-bold">Explorador de Documentos</span>
      </div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900 font-sans">
        Archivos Multimedia e Informes IMCE
      </h1>
      <p class="text-xs text-slate-500 mt-0.5">
        Subida, gestión y copiado de URLs para imágenes y documentos oficiales.
      </p>
    </div>

    <!-- Botón de Subida Principal -->
    <div class="flex items-center gap-3">
      <button
        type="button"
        id="trigger-upload-modal-btn"
        class="inline-flex items-center gap-2 bg-unlu-green hover:bg-unlu-green-dark text-white font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl shadow-md transition-transform active:scale-95 cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        <span>Subir Archivo al Servidor</span>
      </button>
    </div>
  </div>

  <!-- Zona Drag & Drop de Subida -->
  <div
    id="drag-drop-zone"
    class="border-2 border-dashed border-slate-300 hover:border-unlu-green bg-slate-50/50 hover:bg-emerald-50/30 rounded-2xl p-6 sm:p-8 text-center transition-all cursor-pointer group"
  >
    <div class="max-w-md mx-auto space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-center justify-center mx-auto text-unlu-green group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-bold text-slate-800">
          Arrastra y suelta aquí tus archivos o <span class="text-unlu-green underline">examina tu equipo</span>
        </p>
        <p class="text-xs text-slate-500 mt-1">Soporta PDF, PNG, JPG, DOCX de hasta 20 MB por archivo</p>
      </div>
      <input type="file" id="file-input-hidden" class="hidden" multiple />
    </div>
  </div>

  <!-- Barra de Filtros, Búsqueda y Modos de Vista -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex flex-col md:flex-row items-center justify-between gap-4">
    
    <!-- Filtros de Categoría -->
    <div class="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto pb-1 md:pb-0">
      <button data-cat="all" class="filter-chip active bg-unlu-green text-white font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors cursor-pointer">
        Todos (<span id="cat-count-all">0</span>)
      </button>
      <button data-cat="image" class="filter-chip bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors cursor-pointer">
        Imágenes (<span id="cat-count-image">0</span>)
      </button>
      <button data-cat="pdf" class="filter-chip bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors cursor-pointer">
        Documentos PDF (<span id="cat-count-pdf">0</span>)
      </button>
      <button data-cat="other" class="filter-chip bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors cursor-pointer">
        Otros (<span id="cat-count-other">0</span>)
      </button>
    </div>

    <!-- Buscador y Selector de Vista -->
    <div class="flex items-center justify-between md:justify-end gap-3 w-full md:w-auto">
      <div class="relative w-full sm:w-64">
        <input
          type="text"
          id="file-search-input"
          placeholder="Buscar archivo por nombre..."
          class="w-full bg-slate-100 border border-slate-300 rounded-xl pl-9 pr-3 py-1.5 text-xs text-slate-800 focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <div class="flex items-center border border-slate-300 rounded-xl p-1 bg-slate-100 shrink-0">
        <button id="view-mode-grid-btn" class="p-1 rounded-lg bg-white shadow-xs text-slate-800 cursor-pointer" title="Vista en Grilla">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
        </button>
        <button id="view-mode-list-btn" class="p-1 rounded-lg text-slate-500 hover:text-slate-900 cursor-pointer" title="Vista en Lista Detallada">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

  </div>

  <!-- Contenedor Principal de Archivos -->
  <div id="files-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
    <!-- Renderizado dinámico -->
  </div>
</div>

<script is:inline>
  (function() {
    const DEFAULT_FILES = [
      { id: 'f-1', name: 'Informe Preliminar 2025 IPLAN-CA7.pdf', type: 'pdf', size: '174.64 KB', date: '22/05/2025', url: '/files/Informe_Preliminar_2025.pdf' },
      { id: 'f-2', name: 'Autoevaluación Institucional 2022.png', type: 'image', size: '107.81 KB', date: '11/02/2025', url: '/files/Autoevaluacion_2022.png', preview: '/escudo.svg' },
      { id: 'f-3', name: 'Formato para la Presentación de Proyectos.pdf', type: 'pdf', size: '93.44 KB', date: '10/02/2025', url: '/files/Formato_Presentacion_Proyectos.pdf' },
      { id: 'f-4', name: 'banner.jpg', type: 'image', size: '24.29 KB', date: '12/07/2023', url: '/files/banner.jpg', preview: '/escudo.svg' },
      { id: 'f-5', name: 'auto_julio_2023.jpg', type: 'image', size: '134.78 KB', date: '12/07/2023', url: '/files/auto_julio_2023.jpg', preview: '/escudo.svg' },
      { id: 'f-6', name: 'logo-transparente.png', type: 'image', size: '17.90 KB', date: '23/06/2016', url: '/files/logo-transparente.png', preview: '/escudo.svg' }
    ];

    let currentCategory = 'all';
    let currentSearch = '';
    let isGridView = true;

    function getStoredFiles() {
      try {
        const saved = JSON.parse(localStorage.getItem('unlu_admin_files') || 'null');
        return saved || DEFAULT_FILES;
      } catch(e) {
        return DEFAULT_FILES;
      }
    }

    function saveStoredFiles(files) {
      localStorage.setItem('unlu_admin_files', JSON.stringify(files));
    }

    function renderFiles() {
      const container = document.getElementById('files-container');
      if (!container) return;

      const files = getStoredFiles();

      // Conteos
      const countAll = files.length;
      const countImg = files.filter(f => f.type === 'image').length;
      const countPdf = files.filter(f => f.type === 'pdf').length;
      const countOther = files.filter(f => f.type !== 'image' && f.type !== 'pdf').length;

      document.getElementById('cat-count-all').textContent = countAll;
      document.getElementById('cat-count-image').textContent = countImg;
      document.getElementById('cat-count-pdf').textContent = countPdf;
      document.getElementById('cat-count-other').textContent = countOther;

      let filtered = files;
      if (currentCategory === 'image') filtered = filtered.filter(f => f.type === 'image');
      if (currentCategory === 'pdf') filtered = filtered.filter(f => f.type === 'pdf');
      if (currentCategory === 'other') filtered = filtered.filter(f => f.type !== 'image' && f.type !== 'pdf');

      if (currentSearch) {
        const term = currentSearch.toLowerCase();
        filtered = filtered.filter(f => f.name.toLowerCase().includes(term));
      }

      if (filtered.length === 0) {
        container.className = "w-full";
        container.innerHTML = `
          <div class="bg-white p-12 rounded-2xl border border-slate-200 text-center text-slate-500">
            <p class="font-bold text-sm">No se encontraron archivos.</p>
            <p class="text-xs mt-1">Prueba cambiando el filtro o término de búsqueda.</p>
          </div>
        `;
        return;
      }

      if (isGridView) {
        container.className = "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5";
        container.innerHTML = filtered.map(file => `
          <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-all overflow-hidden group">
            <div class="h-32 ${file.type === 'image' ? 'bg-slate-900' : 'bg-slate-100'} flex items-center justify-center relative overflow-hidden p-4">
              ${file.type === 'image' 
                ? `<img src="${file.preview || file.url}" alt="" class="max-h-full max-w-full object-contain opacity-80 group-hover:opacity-100 transition-opacity" />`
                : `<div class="w-14 h-14 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center font-bold text-xs uppercase shadow-sm">PDF</div>`
              }
              <span class="absolute top-2 right-2 text-[10px] font-bold bg-black/70 text-white px-2 py-0.5 rounded-md">
                ${file.size}
              </span>
            </div>
            <div class="p-4 space-y-2">
              <h3 class="text-xs font-bold text-slate-900 truncate" title="${file.name}">
                ${file.name}
              </h3>
              <div class="text-[11px] text-slate-500 flex items-center justify-between">
                <span>${file.date}</span>
                <span class="font-mono uppercase">${file.type}</span>
              </div>
              <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
                <button
                  onclick="navigator.clipboard.writeText('${file.url}'); alert('URL copiada: ${file.url}');"
                  class="flex-1 text-center text-xs font-semibold text-unlu-green hover:bg-emerald-50 py-1.5 rounded-lg border border-emerald-200 transition-colors cursor-pointer"
                >
                  Copiar Link
                </button>
                <button
                  onclick="window.deleteAdminFile('${file.id}')"
                  class="text-xs text-red-500 hover:text-red-700 hover:bg-red-50 p-1.5 rounded-lg transition-colors cursor-pointer"
                  title="Eliminar archivo"
                >
                  🗑️
                </button>
              </div>
            </div>
          </div>
        `).join('');
      } else {
        container.className = "space-y-2 bg-white rounded-2xl border border-slate-200 overflow-hidden divide-y divide-slate-100";
        container.innerHTML = filtered.map(file => `
          <div class="p-4 flex items-center justify-between gap-4 hover:bg-slate-50">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-9 h-9 rounded-xl ${file.type==='image'?'bg-emerald-100 text-unlu-green':'bg-red-100 text-red-600'} font-bold text-xs flex items-center justify-center shrink-0">
                ${file.type === 'image' ? 'IMG' : 'PDF'}
              </div>
              <div class="min-w-0">
                <div class="text-xs font-bold text-slate-900 truncate">${file.name}</div>
                <div class="text-[11px] text-slate-500">${file.date} • ${file.size}</div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button
                onclick="navigator.clipboard.writeText('${file.url}'); alert('URL copiada: ${file.url}');"
                class="text-xs font-semibold text-unlu-green bg-emerald-50 hover:bg-emerald-100 px-3 py-1.5 rounded-lg border border-emerald-200 transition-colors cursor-pointer"
              >
                Copiar Link
              </button>
              <button
                onclick="window.deleteAdminFile('${file.id}')"
                class="text-xs text-red-500 hover:text-red-700 hover:bg-red-50 p-1.5 rounded-lg transition-colors cursor-pointer"
              >
                Eliminar
              </button>
            </div>
          </div>
        `).join('');
      }
    }

    window.deleteAdminFile = function(id) {
      if(!confirm('¿Seguro que deseas eliminar este archivo?')) return;
      const files = getStoredFiles().filter(f => f.id !== id);
      saveStoredFiles(files);
      renderFiles();
    };

    // Eventos de Filtro por Categoría
    document.querySelectorAll('.filter-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-chip').forEach(b => {
          b.classList.remove('active', 'bg-unlu-green', 'text-white');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });
        btn.classList.add('active', 'bg-unlu-green', 'text-white');
        btn.classList.remove('bg-slate-100', 'text-slate-700');

        currentCategory = btn.getAttribute('data-cat') || 'all';
        renderFiles();
      });
    });

    // Evento de Búsqueda
    document.getElementById('file-search-input')?.addEventListener('input', (e) => {
      currentSearch = e.target.value;
      renderFiles();
    });

    // Modos de Vista
    const gridBtn = document.getElementById('view-mode-grid-btn');
    const listBtn = document.getElementById('view-mode-list-btn');

    gridBtn?.addEventListener('click', () => {
      isGridView = true;
      gridBtn.classList.add('bg-white', 'shadow-xs', 'text-slate-800');
      gridBtn.classList.remove('text-slate-500');
      listBtn?.classList.remove('bg-white', 'shadow-xs', 'text-slate-800');
      listBtn?.classList.add('text-slate-500');
      renderFiles();
    });

    listBtn?.addEventListener('click', () => {
      isGridView = false;
      listBtn.classList.add('bg-white', 'shadow-xs', 'text-slate-800');
      listBtn.classList.remove('text-slate-500');
      gridBtn?.classList.remove('bg-white', 'shadow-xs', 'text-slate-800');
      gridBtn?.classList.add('text-slate-500');
      renderFiles();
    });

    // Subida de Archivos
    const dragZone = document.getElementById('drag-drop-zone');
    const fileInput = document.getElementById('file-input-hidden');
    const triggerBtn = document.getElementById('trigger-upload-modal-btn');

    if (dragZone && fileInput) {
      dragZone.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) {
          const filesArr = getStoredFiles();
          Array.from(fileInput.files).forEach(f => {
            const isImg = f.type.startsWith('image/');
            const isPdf = f.type === 'application/pdf' || f.name.endsWith('.pdf');
            const fileObj = {
              id: 'f-' + Math.random().toString(36).slice(2,8),
              name: f.name,
              type: isImg ? 'image' : isPdf ? 'pdf' : 'other',
              size: (f.size / 1024).toFixed(2) + ' KB',
              date: new Date().toLocaleDateString('es-AR'),
              url: URL.createObjectURL(f),
              preview: isImg ? URL.createObjectURL(f) : null
            };
            filesArr.unshift(fileObj);
          });
          saveStoredFiles(filesArr);
          renderFiles();
          alert(`¡Archivos subidos exitosamente! ${fileInput.files.length} archivo(s) añadido(s) a la biblioteca.`);
        }
      });
    }

    triggerBtn?.addEventListener('click', () => fileInput?.click());

    // Inicializar render
    renderFiles();
  })();
</script>
