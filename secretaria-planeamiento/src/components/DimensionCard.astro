---
/**
 * Componente: DimensionCard
 * Tarjeta para las Comisiones de Trabajo por Dimensión del Plan de Desarrollo Institucional (PDI).
 */
interface Props {
  dimensionNumber: string;
  title: string;
  description: string;
  focusAreas: string[];
  reportAvailable?: boolean;
}

const {
  dimensionNumber,
  title,
  description,
  focusAreas,
  reportAvailable = true
} = Astro.props;
---

<div class="bg-white rounded-xl p-6 sm:p-7 border border-gray-200 shadow-xs hover:shadow-md hover:border-unlu-green transition-all duration-200 flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between mb-3">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-unlu-green/5 text-unlu-green border border-unlu-green/20">
        {dimensionNumber}
      </span>
      {reportAvailable && (
        <span class="inline-flex items-center gap-1 text-[11px] font-medium text-unlu-green bg-unlu-green/5 px-2 py-0.5 rounded-md">
          <span class="w-1.5 h-1.5 rounded-full bg-unlu-green"></span>
          Informe final
        </span>
      )}
    </div>

    <h3 class="text-xl font-bold text-gray-900 mb-2 font-serif">
      {title}
    </h3>

    <p class="text-sm text-gray-600 leading-relaxed mb-4">
      {description}
    </p>

    {focusAreas.length > 0 && (
      <div class="border-t border-gray-100 pt-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Áreas de enfoque</h4>
        <div class="flex flex-wrap gap-1.5">
          {focusAreas.map((area) => (
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-700">
              {area}
            </span>
          ))}
        </div>
      </div>
    )}
  </div>

  <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between">
    <span class="text-xs text-gray-500 font-medium">Comisión HCS</span>
    <a
      href="#dimensiones"
      class="inline-flex items-center text-xs font-bold text-unlu-green hover:text-unlu-green-dark group"
    >
      Ver informe
      <svg class="w-3.5 h-3.5 ml-1 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
