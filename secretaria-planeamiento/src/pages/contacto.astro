---
/**
 * Página: Contacto
 * Cabecera hero con datos de contacto integrados.
 * Luego: bloque de Atención al Público, y finalmente el formulario.
 */
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import BlockRenderer from "../blocks/BlockRenderer.astro";
import pageData from "../data/pages/contacto.json";

const { meta = {}, blocks = [] } = pageData;
---

<Layout 
  title="Contacto · Secretaría de Planeamiento UNLu" 
  activeSection="contacto"
>
  <!-- ===== HERO: Cabecera verde con datos de contacto integrados ===== -->
  <section class="bg-gradient-to-br from-unlu-green via-[#006834] to-unlu-green-dark text-white pt-6 pb-0 overflow-hidden relative">
    <!-- Ornamento de fondo sutil -->
    <div class="absolute inset-0 opacity-5 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-20 -right-20 w-96 h-96 rounded-full border-[40px] border-white"></div>
      <div class="absolute bottom-0 -left-10 w-64 h-64 rounded-full border-[30px] border-white"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      
      <!-- Migas de Pan -->
      <nav aria-label="Breadcrumb" class="pb-4">
        <ol class="flex items-center space-x-1.5 text-xs text-white/60">
          <li>
            <a href="/" class="hover:text-white transition-colors">Inicio</a>
          </li>
          <li class="flex items-center space-x-1.5">
            <span class="text-white/30">&gt;</span>
            <span class="text-white font-medium" aria-current="page">Contacto</span>
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pb-8 items-center">

        <!-- Lado izquierdo: Título, descripción + logo integrado -->
        <div>
          <!-- Badge con logo integrado -->
          <div class="flex items-center gap-3 mb-3">
            <!-- Logo UNLu filtrado a blanco para visibilidad sobre fondo verde -->
            <img
              src="/unlu-logo.svg"
              alt="Universidad Nacional de Luján"
              class="h-8 w-auto opacity-90"
              style="filter: brightness(0) invert(1);"
            />
            <span class="text-xs font-bold tracking-[0.18em] uppercase text-unlu-gold" data-hero-badge>
              {meta.heroBadge || "Secretaría de Planeamiento"}
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white font-serif leading-tight mb-3" data-hero-title>
            {meta.heroTitle || "Ponete en contacto con nosotros"}
          </h1>
          <p class="text-sm sm:text-base text-white/80 leading-relaxed max-w-lg" data-hero-subtitle>
            {meta.heroSubtitle || "Consultas sobre autoevaluación institucional, Plan de Desarrollo (PDI) o presentación de proyectos y propuestas."}
          </p>
        </div>

        <!-- Lado derecho: datos de contacto (Correo y Teléfono) -->
        <div class="flex flex-col gap-3 self-center ml-auto w-full max-w-sm">

          <!-- Correo -->
          <div class="group flex items-center justify-between gap-3 bg-white/10 hover:bg-white/15 border border-white/15 hover:border-white/30 rounded-xl p-3.5 transition-all duration-200 backdrop-blur-sm">
            <a href="mailto:planeamiento@unlu.edu.ar" class="flex items-start gap-3 min-w-0 flex-1">
              <div class="w-9 h-9 rounded-lg bg-unlu-gold/20 text-unlu-gold flex items-center justify-center shrink-0">
                <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div class="min-w-0">
                <span class="block text-[10px] font-bold uppercase tracking-wider text-white/50 mb-0.5">Correo</span>
                <span class="block text-sm font-semibold text-white group-hover:text-unlu-gold transition-colors break-all leading-snug" data-hero-email>{meta.email || "planeamiento@unlu.edu.ar"}</span>
              </div>
            </a>
            <button
              type="button"
              data-copy="planeamiento@unlu.edu.ar"
              title="Copiar dirección de correo"
              aria-label="Copiar correo"
              class="copy-btn shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white/90 text-xs font-medium transition-all border border-white/15 cursor-pointer active:scale-95"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 01-2-2v-8a2 2 0 01-2-2h-8a2 2 0 01-2 2v8a2 2 0 012 2z" />
              </svg>
              <span class="copy-label">Copiar</span>
            </button>
          </div>

          <!-- Teléfono -->
          <div class="group flex items-center justify-between gap-3 bg-white/10 hover:bg-white/15 border border-white/15 hover:border-white/30 rounded-xl p-3.5 transition-all duration-200 backdrop-blur-sm">
            <a href="tel:+5402323445100" class="flex items-start gap-3 min-w-0 flex-1">
              <div class="w-9 h-9 rounded-lg bg-unlu-gold/20 text-unlu-gold flex items-center justify-center shrink-0">
                <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div class="min-w-0">
                <span class="block text-[10px] font-bold uppercase tracking-wider text-white/50 mb-0.5">Teléfono</span>
                <span class="block text-sm font-semibold text-white group-hover:text-unlu-gold transition-colors leading-snug" data-hero-phone>{meta.telefono || "+54 (02323) 445100"}</span>
                <span class="text-xs font-bold text-unlu-gold">{meta.interno || "Interno 1200"}</span>
              </div>
            </a>
            <button
              type="button"
              data-copy="+54 (02323) 445100"
              title="Copiar número de teléfono"
              aria-label="Copiar teléfono"
              class="copy-btn shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white/90 text-xs font-medium transition-all border border-white/15 cursor-pointer active:scale-95"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 012-2v-8a2 2 0 01-2-2h-8a2 2 0 01-2 2v8a2 2 0 012 2z" />
              </svg>
              <span class="copy-label">Copiar</span>
            </button>
          </div>

        </div>

      </div>
    </div>

    <!-- Borde ondulado al final del hero para transición suave -->
    <div class="w-full overflow-hidden leading-none mt-0" aria-hidden="true">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none" class="w-full h-10 block">
        <path d="M0,30 C240,0 480,40 720,20 C960,0 1200,40 1440,20 L1440,40 L0,40 Z" fill="#f3f4f6" />
      </svg>
    </div>
  </section>

  <!-- ===== CUERPO: Bloques Editables (Atención al Público + Formulario de Consulta) ===== -->
  <div class="bg-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 pt-6">
      <BlockRenderer blocks={blocks} />
    </div>
  </div>
</Layout>

<script is:inline>
  window.toggleMapExpand = function(btn) {
    const container = btn.closest('.card-atencion-mapa-container');
    if (!container) return;
    const teaserBar = container.querySelector('.map-teaser-bar');
    const expandedPanel = container.querySelector('.map-expanded-panel');
    const btnText = container.querySelector('.map-btn-text');
    const btnArrow = container.querySelector('.map-btn-arrow');
    const isExpanded = container.getAttribute('data-expanded') === 'true';

    if (isExpanded) {
      container.setAttribute('data-expanded', 'false');
      if (teaserBar) teaserBar.style.display = 'flex';
      if (expandedPanel) expandedPanel.style.display = 'none';
      if (btnText) btnText.textContent = 'Ver mapa';
      if (btnArrow) btnArrow.style.transform = 'rotate(0deg)';
    } else {
      container.setAttribute('data-expanded', 'true');
      if (teaserBar) teaserBar.style.display = 'none';
      if (expandedPanel) expandedPanel.style.display = 'block';
      if (btnText) btnText.textContent = 'Ocultar mapa';
      if (btnArrow) btnArrow.style.transform = 'rotate(180deg)';
    }
  };

  window.toggleMapExpandFromTeaser = function(teaserEl) {
    const container = teaserEl.closest('.card-atencion-mapa-container');
    if (!container) return;
    const btn = container.querySelector('button[onclick*="toggleMapExpand"]');
    if (btn) toggleMapExpand(btn);
  };

  (function() {
    try {
      const saved = JSON.parse(localStorage.getItem('unlu_blocks_v30') || '{}');
      const data = saved['contacto'];
      if (!data) return;
      const meta = data.meta;
      if (meta) {
        if (meta.heroBadge) { document.querySelectorAll('[data-hero-badge]').forEach(el => el.textContent = meta.heroBadge); }
        if (meta.heroTitle) { document.querySelectorAll('[data-hero-title]').forEach(el => el.textContent = meta.heroTitle); }
        if (meta.heroSubtitle) { document.querySelectorAll('[data-hero-subtitle]').forEach(el => el.textContent = meta.heroSubtitle); }
        if (meta.email) { document.querySelectorAll('[data-hero-email]').forEach(el => el.textContent = meta.email); }
        if (meta.telefono) { document.querySelectorAll('[data-hero-phone]').forEach(el => el.textContent = meta.telefono); }
      }
    } catch(e) {}
  })();
</script>

<script>
  const toggle = document.getElementById('atencion-toggle');
  const panel = document.getElementById('atencion-mapa');
  const teaser = document.getElementById('map-teaser');
  const mapIcon = document.getElementById('map-icon-toggle');
  const mapLabel = document.getElementById('map-label-toggle');

  if (toggle && panel && teaser) {
    // El teaser también abre el mapa al clickear
    teaser.addEventListener('click', () => toggle.click());

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        // Cerrar
        panel.style.maxHeight = '0px';
        toggle.setAttribute('aria-expanded', 'false');
        teaser.style.height = '4rem'; // h-16
        teaser.style.opacity = '1';
        if (mapIcon) mapIcon.style.transform = 'rotate(0deg)';
        if (mapLabel) mapLabel.textContent = 'Ver mapa';
        document.getElementById('map-btn-toggle')?.classList.remove('bg-unlu-gold', 'text-unlu-green-dark', 'border-unlu-gold');
      } else {
        // Abrir
        panel.style.maxHeight = panel.scrollHeight + 'px';
        toggle.setAttribute('aria-expanded', 'true');
        teaser.style.height = '0px';
        teaser.style.opacity = '0';
        if (mapIcon) mapIcon.style.transform = 'rotate(180deg)';
        if (mapLabel) mapLabel.textContent = 'Ocultar mapa';
        document.getElementById('map-btn-toggle')?.classList.add('bg-unlu-gold', 'text-unlu-green-dark', 'border-unlu-gold');
      }
    });
  }

  // Funcionalidad para copiar correo y teléfono al portapapeles
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const textToCopy = btn.getAttribute('data-copy');
      if (textToCopy) {
        try {
          await navigator.clipboard.writeText(textToCopy);
          const label = btn.querySelector('.copy-label');
          const originalText = label ? label.textContent : 'Copiar';
          btn.classList.add('bg-unlu-gold', 'text-unlu-green-dark', 'font-bold', 'border-unlu-gold');
          if (label) label.textContent = '¡Copiado!';
          setTimeout(() => {
            btn.classList.remove('bg-unlu-gold', 'text-unlu-green-dark', 'font-bold', 'border-unlu-gold');
            if (label) label.textContent = originalText;
          }, 2000);
        } catch (err) {
          console.error('Error al copiar al portapapeles:', err);
        }
      }
    });
  });
</script>
