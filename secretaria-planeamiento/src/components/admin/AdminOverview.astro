---
/**
 * Componente: AdminOverview
 * Vista de resumen / Inicio del Dashboard de Administración
 */
---

<div class="space-y-8">
  <!-- Banner de bienvenida -->
  <div class="bg-gradient-to-r from-unlu-green-dark via-unlu-green to-emerald-800 text-white rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none">
      <img src="/escudo.svg" alt="" class="w-64 h-64 invert" />
    </div>
    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-unlu-gold border border-white/20 mb-4">
        <span>Panel de Control Institucional</span>
        <span>•</span>
        <span>Versión 2.0</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-white font-sans mb-2">
        Bienvenido/a, usuplanea 👋
      </h1>
      <p class="text-emerald-100 text-sm sm:text-base leading-relaxed">
        Gestión centralizada de contenidos, documentos y estructura de la Secretaría de Planeamiento. Selecciona una acción rápida o explora el menú lateral para actualizar el portal.
      </p>

      <div class="flex flex-wrap items-center gap-3 mt-6">
        <button
          onclick="window.switchTab('editor', 'autoevaluacion')"
          class="inline-flex items-center gap-2 bg-unlu-gold hover:bg-unlu-gold-light text-slate-900 font-bold px-4 py-2.5 rounded-xl shadow-md transition-all transform hover:-translate-y-0.5 text-sm"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Editar Autoevaluación
        </button>

        <button
          onclick="window.switchTab('files')"
          class="inline-flex items-center gap-2 bg-white/15 hover:bg-white/25 text-white font-medium px-4 py-2.5 rounded-xl backdrop-blur-md transition-all text-sm border border-white/20"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          Subir Documento
        </button>

        <button
          onclick="window.switchTab('editor', 'new')"
          class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-emerald-100 font-medium px-4 py-2.5 rounded-xl transition-all text-sm"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Crear Nueva Página
        </button>
      </div>
    </div>
  </div>

  <!-- Tarjetas de Métricas -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <!-- Métrica 1 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Páginas Activas</span>
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-unlu-green flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold text-slate-900">14</span>
        <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">Todas visibles</span>
      </div>
      <p class="text-xs text-slate-500 mt-2">Última actualización hoy 16:24</p>
    </div>

    <!-- Métrica 2 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Documentos & Archivos</span>
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold text-slate-900">28</span>
        <span class="text-xs font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full">645 KB usables</span>
      </div>
      <p class="text-xs text-slate-500 mt-2">Formatos PDF, PNG, JPG</p>
    </div>

    <!-- Métrica 3 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Ediciones este mes</span>
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold text-slate-900">12</span>
        <span class="text-xs font-medium text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">Por usuplanea</span>
      </div>
      <p class="text-xs text-slate-500 mt-2">Sin revisiones pendientes</p>
    </div>

    <!-- Métrica 4 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Estado Servidor</span>
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-xl font-bold text-slate-900">100% Online</span>
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
      </div>
      <p class="text-xs text-slate-500 mt-2">Conexión segura SSL activa</p>
    </div>
  </div>

  <!-- Sección Central: Accesos Rápida a Páginas Principales y Actividad Reciente -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Listado y Edición Rápida de Páginas (2 columnas) -->
    <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <div>
          <h2 class="text-lg font-bold text-slate-900 font-sans">Páginas Principales del Portal</h2>
          <p class="text-xs text-slate-500">Selecciona cualquier página para editar su contenido directamente</p>
        </div>
        <button
          onclick="window.switchTab('site')"
          class="text-xs font-semibold text-unlu-green hover:underline flex items-center gap-1"
        >
          <span>Ver todas (14)</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <div class="space-y-3">
        <!-- Página 1: Autoevaluación Institucional -->
        <div class="flex items-center justify-between p-4 rounded-xl border border-slate-200/70 hover:border-unlu-green/50 hover:bg-slate-50/80 transition-all group">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-emerald-100/80 text-unlu-green flex items-center justify-center font-bold text-sm shrink-0">
              AI
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900 group-hover:text-unlu-green transition-colors">Autoevaluación Institucional</h3>
              <div class="flex items-center gap-2 text-xs text-slate-500 mt-0.5">
                <span class="inline-flex items-center gap-1 text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[11px] font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Publicado
                </span>
                <span>•</span>
                <span>Ruta: /autoevaluacion</span>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <a href="/autoevaluacion" target="_blank" class="p-2 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-white transition-colors" title="Ver versión pública">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <button
              onclick="window.switchTab('editor', 'autoevaluacion')"
              class="inline-flex items-center gap-1.5 bg-unlu-green/10 hover:bg-unlu-green text-unlu-green hover:text-white font-semibold text-xs px-3 py-2 rounded-lg transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              <span>Editar</span>
            </button>
          </div>
        </div>

        <!-- Página 2: Plan de Desarrollo Institucional -->
        <div class="flex items-center justify-between p-4 rounded-xl border border-slate-200/70 hover:border-unlu-green/50 hover:bg-slate-50/80 transition-all group">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-amber-100/80 text-amber-800 flex items-center justify-center font-bold text-sm shrink-0">
              PD
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900 group-hover:text-unlu-green transition-colors">Plan de Desarrollo Institucional</h3>
              <div class="flex items-center gap-2 text-xs text-slate-500 mt-0.5">
                <span class="inline-flex items-center gap-1 text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[11px] font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Publicado
                </span>
                <span>•</span>
                <span>Ruta: /plan-desarrollo</span>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <a href="/plan-desarrollo" target="_blank" class="p-2 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-white transition-colors" title="Ver versión pública">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <button
              onclick="window.switchTab('editor', 'pdi')"
              class="inline-flex items-center gap-1.5 bg-unlu-green/10 hover:bg-unlu-green text-unlu-green hover:text-white font-semibold text-xs px-3 py-2 rounded-lg transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              <span>Editar</span>
            </button>
          </div>
        </div>

        <!-- Página 3: La Secretaría -->
        <div class="flex items-center justify-between p-4 rounded-xl border border-slate-200/70 hover:border-unlu-green/50 hover:bg-slate-50/80 transition-all group">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-blue-100/80 text-blue-800 flex items-center justify-center font-bold text-sm shrink-0">
              LS
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900 group-hover:text-unlu-green transition-colors">La Secretaría (Misión y Autoridades)</h3>
              <div class="flex items-center gap-2 text-xs text-slate-500 mt-0.5">
                <span class="inline-flex items-center gap-1 text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[11px] font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Publicado
                </span>
                <span>•</span>
                <span>Ruta: /la-secretaria</span>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <a href="/la-secretaria" target="_blank" class="p-2 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-white transition-colors" title="Ver versión pública">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <button
              onclick="window.switchTab('editor', 'la-secretaria')"
              class="inline-flex items-center gap-1.5 bg-unlu-green/10 hover:bg-unlu-green text-unlu-green hover:text-white font-semibold text-xs px-3 py-2 rounded-lg transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              <span>Editar</span>
            </button>
          </div>
        </div>

        <!-- Página 4: Contacto -->
        <div class="flex items-center justify-between p-4 rounded-xl border border-slate-200/70 hover:border-unlu-green/50 hover:bg-slate-50/80 transition-all group">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-purple-100/80 text-purple-800 flex items-center justify-center font-bold text-sm shrink-0">
              CT
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900 group-hover:text-unlu-green transition-colors">Contacto e Internos UNLu</h3>
              <div class="flex items-center gap-2 text-xs text-slate-500 mt-0.5">
                <span class="inline-flex items-center gap-1 text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[11px] font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Publicado
                </span>
                <span>•</span>
                <span>Ruta: /contacto</span>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <a href="/contacto" target="_blank" class="p-2 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-white transition-colors" title="Ver versión pública">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <button
              onclick="window.switchTab('editor', 'contacto')"
              class="inline-flex items-center gap-1.5 bg-unlu-green/10 hover:bg-unlu-green text-unlu-green hover:text-white font-semibold text-xs px-3 py-2 rounded-lg transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              <span>Editar</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Timeline de Historial / Actividad Reciente -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
      <div class="border-b border-slate-100 pb-4">
        <h2 class="text-lg font-bold text-slate-900 font-sans">Historial de Actividad</h2>
        <p class="text-xs text-slate-500">Últimas acciones realizadas en la plataforma</p>
      </div>

      <div class="relative pl-6 space-y-6 before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200">
        <!-- Evento 1 -->
        <div class="relative">
          <div class="absolute -left-[23px] top-1 w-3.5 h-3.5 rounded-full bg-unlu-green border-2 border-white ring-2 ring-emerald-100"></div>
          <div>
            <p class="text-xs font-semibold text-slate-900">Página actualizada: Autoevaluación</p>
            <p class="text-[11px] text-slate-500 mt-0.5">Por <strong class="text-slate-700">usuplanea</strong> • Hoy 16:24</p>
            <span class="inline-block mt-1 text-[10px] text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded font-mono">Edición de contenido HTML</span>
          </div>
        </div>

        <!-- Evento 2 -->
        <div class="relative">
          <div class="absolute -left-[23px] top-1 w-3.5 h-3.5 rounded-full bg-amber-500 border-2 border-white ring-2 ring-amber-100"></div>
          <div>
            <p class="text-xs font-semibold text-slate-900">Documento subido: Informe_2025.pdf</p>
            <p class="text-[11px] text-slate-500 mt-0.5">Por <strong class="text-slate-700">usuplanea</strong> • 22/05/2026 15:41</p>
            <span class="inline-block mt-1 text-[10px] text-amber-800 bg-amber-50 px-2 py-0.5 rounded font-mono">174.64 KB en servidor</span>
          </div>
        </div>

        <!-- Evento 3 -->
        <div class="relative">
          <div class="absolute -left-[23px] top-1 w-3.5 h-3.5 rounded-full bg-blue-500 border-2 border-white ring-2 ring-blue-100"></div>
          <div>
            <p class="text-xs font-semibold text-slate-900">Imagen reemplazada: banner.jpg</p>
            <p class="text-[11px] text-slate-500 mt-0.5">Por <strong class="text-slate-700">usuplanea</strong> • 12/07/2025 12:33</p>
            <span class="inline-block mt-1 text-[10px] text-blue-800 bg-blue-50 px-2 py-0.5 rounded font-mono">1200 x 119 px</span>
          </div>
        </div>

        <!-- Evento 4 -->
        <div class="relative">
          <div class="absolute -left-[23px] top-1 w-3.5 h-3.5 rounded-full bg-slate-400 border-2 border-white"></div>
          <div>
            <p class="text-xs font-semibold text-slate-900">Inicio de sesión exitoso</p>
            <p class="text-[11px] text-slate-500 mt-0.5">Usuario: <strong class="text-slate-700">usuplanea</strong></p>
          </div>
        </div>
      </div>

      <div class="pt-2 border-t border-slate-100">
        <a href="/admin?tab=profile" class="text-xs text-slate-600 hover:text-unlu-green font-medium flex items-center gap-1 justify-center">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>Ver perfil del usuario (Miembro hace 16 años)</span>
        </a>
      </div>
    </div>

  </div>
</div>
