---
/**
 * Componente: AdminContentEditor
 * Editor de páginas basado en el sistema de Bloques (Opción C).
 * - Sincronizado 100% con los archivos JSON de src/data/pages.
 * - Vista previa completa sin recortes ni truncamiento.
 */
import autoevaluacionData from "../../data/pages/autoevaluacion.json";
import planDesarrolloData from "../../data/pages/plan-desarrollo.json";
import laSecretariaData from "../../data/pages/la-secretaria.json";
import contactoData from "../../data/pages/contacto.json";

const SERVER_BASE_PAGES = {
  autoevaluacion: autoevaluacionData,
  "plan-desarrollo": planDesarrolloData,
  "la-secretaria": laSecretariaData,
  contacto: contactoData,
};
---

<script is:inline set:html={`window.SERVER_BASE_PAGES = ${JSON.stringify(SERVER_BASE_PAGES)};`} />

<div class="space-y-6" id="admin-editor-root">

  <!-- Encabezado + Selector de Página -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
        <a href="/admin" class="hover:text-unlu-green">Dashboard</a>
        <span>/</span>
        <span class="text-slate-900 font-bold">Editor de Páginas</span>
      </div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900 font-sans flex items-center gap-2 flex-wrap">
        <span>Editor de Contenido</span>
        <span id="editing-badge" class="text-xs bg-emerald-100 text-unlu-green border border-emerald-300 font-semibold px-2.5 py-0.5 rounded-full">
          Editando: Autoevaluación
        </span>
      </h1>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <select id="page-selector" class="bg-slate-100 border border-slate-300 text-slate-800 text-xs sm:text-sm rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-unlu-green focus:bg-white focus:outline-none transition-all">
        <option value="autoevaluacion" selected>Autoevaluación Institucional</option>
        <option value="plan-desarrollo">Plan de Desarrollo Institucional</option>
        <option value="la-secretaria">La Secretaría</option>
        <option value="contacto">Contacto</option>
      </select>
      <button type="button" id="reset-btn" class="inline-flex items-center gap-1.5 bg-slate-100 hover:bg-red-50 text-slate-600 hover:text-red-700 border border-slate-300 hover:border-red-300 font-semibold text-xs px-3 py-2 rounded-xl transition-colors" title="Restaurar contenido original">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Reiniciar
      </button>
    </div>
  </div>

  <!-- Panel Principal: Editor de Bloques + Sidebar -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

    <!-- Área de Bloques (3 cols) -->
    <div class="lg:col-span-3 space-y-5">

      <!-- TARJETA EDITABLE DE CABECERA / HERO -->
      <div class="bg-gradient-to-br from-unlu-green via-[#006834] to-unlu-green-dark text-white rounded-2xl p-5 sm:p-6 shadow-md border border-emerald-800 relative overflow-hidden">
        <div class="flex items-center justify-between gap-4 mb-4 pb-3 border-b border-white/15">
          <div class="flex items-center gap-2">
            <span class="text-xl">⭐</span>
            <div>
              <h2 class="text-xs font-bold text-unlu-gold uppercase tracking-widest">Cabecera de Página (Hero Principal)</h2>
              <p class="text-[11px] text-white/80">Título, etiqueta, subtítulo y datos de la marquesina superior</p>
            </div>
          </div>
          <button type="button" onclick="openHeroEditModal()" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-unlu-gold hover:bg-yellow-400 text-unlu-green-dark font-extrabold text-xs transition-all shadow-sm cursor-pointer active:scale-95">
            ✏️ Editar Cabecera (Hero)
          </button>
        </div>

        <!-- Vista previa fiel al Hero real de la página -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-center bg-black/20 rounded-xl p-4 sm:p-5 border border-white/10">
          <!-- Columna izquierda: Logo UNLu + Badge + Título + Subtítulo -->
          <div>
            <div class="flex items-center gap-3 mb-2.5">
              <img src="/unlu-logo.svg" alt="UNLu" class="h-7 w-auto opacity-90" style="filter: brightness(0) invert(1);" />
              <span id="hero-display-badge" class="text-xs font-bold tracking-[0.18em] uppercase text-unlu-gold">...</span>
            </div>
            <h1 id="hero-display-title" class="text-xl sm:text-2xl font-bold font-serif text-white leading-tight mb-2">...</h1>
            <p id="hero-display-subtitle" class="text-xs text-white/85 leading-relaxed">...</p>
          </div>

          <!-- Columna derecha: Tarjetas de contacto (Email / Teléfono) -->
          <div id="hero-display-contact-extras" class="hidden flex flex-col gap-2.5 self-center w-full max-w-sm ml-auto">
            <!-- Email -->
            <div class="flex items-center justify-between gap-3 bg-white/10 border border-white/15 rounded-xl p-3 backdrop-blur-sm">
              <div class="flex items-start gap-2.5 min-w-0">
                <div class="w-8 h-8 rounded-lg bg-unlu-gold/20 text-unlu-gold flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                </div>
                <div class="min-w-0">
                  <span class="block text-[9px] font-bold uppercase tracking-wider text-white/50">Correo</span>
                  <span id="hero-display-email" class="block text-xs font-semibold text-white truncate">...</span>
                </div>
              </div>
              <span class="shrink-0 text-[10px] font-bold bg-white/10 px-2 py-1 rounded text-white/80">Copiar</span>
            </div>

            <!-- Teléfono -->
            <div class="flex items-center justify-between gap-3 bg-white/10 border border-white/15 rounded-xl p-3 backdrop-blur-sm">
              <div class="flex items-start gap-2.5 min-w-0">
                <div class="w-8 h-8 rounded-lg bg-unlu-gold/20 text-unlu-gold flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
                </div>
                <div class="min-w-0">
                  <span class="block text-[9px] font-bold uppercase tracking-wider text-white/50">Teléfono</span>
                  <span id="hero-display-phone" class="block text-xs font-semibold text-white truncate">...</span>
                </div>
              </div>
              <span class="shrink-0 text-[10px] font-bold bg-white/10 px-2 py-1 rounded text-white/80">Copiar</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Barra de Estado + Botón Insertar -->
      <div class="flex items-center justify-between bg-white px-4 py-3 rounded-xl border border-slate-200 shadow-2xs">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-slate-700">Bloques en la página:</span>
          <span id="block-count" class="bg-slate-100 text-slate-800 text-xs font-bold px-2 py-0.5 rounded-md border border-slate-200">0</span>
        </div>
        <button type="button" onclick="openInsertModal(null)" class="inline-flex items-center gap-1.5 bg-unlu-green hover:bg-unlu-green-dark text-white font-bold text-xs px-3.5 py-2 rounded-xl shadow-xs transition-colors cursor-pointer active:scale-95">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Insertar Bloque Prehecho
        </button>
      </div>

      <!-- Lista de bloques actuales de la página -->
      <div id="blocks-container" class="space-y-3 min-h-[200px]"></div>

      <!-- Botón Añadir Bloque -->
      <button
        type="button"
        id="add-block-btn"
        class="w-full flex items-center justify-center gap-2 border-2 border-dashed border-slate-300 hover:border-unlu-green text-slate-500 hover:text-unlu-green bg-white hover:bg-emerald-50/30 rounded-2xl py-5 font-semibold text-sm transition-all"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        Insertar Bloque
      </button>

      <!-- Acciones principales -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <div></div>
        <div class="flex items-center gap-2.5 flex-wrap">
          <button type="button" id="preview-btn" class="inline-flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            Visualizar Resultado
          </button>
          <button type="button" id="save-page-btn" class="inline-flex items-center gap-2 bg-unlu-green hover:bg-unlu-green-dark text-white text-sm font-bold px-6 py-2.5 rounded-xl shadow-md transition-transform active:scale-95">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Guardar Cambios
          </button>
        </div>
      </div>
    </div>

    <!-- Sidebar Información -->
    <div class="space-y-5">
      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 border-b border-slate-100 pb-2">Publicación</h3>
        <div>
          <select id="editor-status" class="w-full bg-slate-50 border border-slate-300 text-slate-800 text-xs font-semibold rounded-xl px-3 py-2 focus:ring-2 focus:ring-unlu-green outline-none">
            <option value="published" selected>🟢 Publicado</option>
            <option value="draft">🟡 Borrador</option>
          </select>
        </div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs text-xs space-y-2">
        <h3 class="font-bold uppercase tracking-wider text-slate-500 border-b border-slate-100 pb-2">Estado</h3>
        <p class="text-slate-600">Bloques en la página: <strong id="block-count" class="text-slate-900">0</strong></p>
        <p class="text-slate-600">Última edición: <strong class="text-slate-900" id="last-edit-time">–</strong></p>
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 text-xs text-amber-800">
        <div class="flex items-start gap-2">
          <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <div>
            <p class="font-bold mb-1">Modo Demostración</p>
            <p class="leading-tight">Los bloques se guardan en este navegador. La vista previa muestra el resultado real.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===== MODAL DE LIBRERÍA DE BLOQUES ===== -->
<div id="block-library-modal" class="fixed inset-0 z-[300] hidden">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeBlockLibrary()"></div>
  <div class="relative z-10 flex h-full items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-4xl max-h-[85vh] flex flex-col overflow-hidden">
      <!-- Header -->
      <div class="p-6 border-b border-slate-200 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Librería de Bloques</h2>
          <p class="text-xs text-slate-500 mt-0.5">Seleccioná el tipo de bloque que querés insertar</p>
        </div>
        <button onclick="closeBlockLibrary()" class="p-2 rounded-xl hover:bg-slate-100 text-slate-400 hover:text-slate-600">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <!-- Grilla de bloques disponibles -->
      <div id="block-library-grid" class="p-6 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 gap-3 flex-1"></div>
    </div>
  </div>
</div>

<!-- ===== MODAL DE PREVISUALIZACIÓN EN GRANDE DE BLOQUE ===== -->
<div id="block-preview-modal" class="fixed inset-0 z-[400] hidden">
  <div class="absolute inset-0 bg-black/65 backdrop-blur-sm" onclick="closeBlockPreviewModal()"></div>
  <div class="relative z-10 flex h-full items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-3xl max-h-[90vh] flex flex-col overflow-hidden">
      <!-- Header -->
      <div class="p-5 border-b border-slate-200 flex items-center justify-between bg-slate-50">
        <div class="flex items-center gap-3">
          <span id="preview-modal-icon" class="text-2xl">📦</span>
          <div>
            <h3 id="preview-modal-title" class="text-base font-bold text-slate-900">Vista Previa del Bloque</h3>
            <p id="preview-modal-desc" class="text-xs text-slate-500">Muestra fiel del diseño en tamaño real</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" id="preview-modal-insert-btn" class="px-4 py-2 text-xs font-bold text-white bg-unlu-green hover:bg-emerald-700 rounded-xl transition-all shadow-md flex items-center gap-1.5 cursor-pointer">
            ➕ Insertar en la Página
          </button>
          <button type="button" onclick="closeBlockPreviewModal()" class="p-2 rounded-xl hover:bg-slate-200 text-slate-500 transition-all cursor-pointer" title="Cerrar">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>
      <!-- Body del Renderizado en Tamaño Real 100% con Scroll -->
      <div class="p-6 overflow-y-auto flex-1 bg-slate-100/50">
        <div class="bg-white rounded-2xl shadow-sm p-6 border border-slate-200">
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-4 border-b border-slate-100 pb-2">Previsualización Real del Diseño (100%):</span>
          <div id="preview-modal-body" class="w-full"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===== MODAL DE EDICIÓN DE HERO / CABECERA ===== -->
<div id="hero-edit-modal" class="fixed inset-0 z-[450] hidden">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeHeroEditModal()"></div>
  <div class="relative z-10 flex h-full items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg max-h-[90vh] flex flex-col overflow-hidden">
      <div class="p-6 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <span>⭐</span> Editar Cabecera de Página (Hero)
        </h2>
        <button onclick="closeHeroEditModal()" class="p-2 rounded-xl hover:bg-slate-100 text-slate-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <div class="p-6 overflow-y-auto flex-1 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Etiqueta Superior (Badge dorado)</label>
          <input type="text" id="input-hero-badge" class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-unlu-green" placeholder="Ej: AUTOEVALUACION INSTITUCIONAL" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Título Principal (H1)</label>
          <input type="text" id="input-hero-title" class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-unlu-green" placeholder="Ej: Autoevaluación Institucional" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Subtítulo / Descripción Corta</label>
          <textarea id="input-hero-subtitle" class="w-full border border-slate-300 rounded-xl p-3 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-unlu-green resize-y min-h-[90px]" placeholder="Ej: Proceso de relevamiento..."></textarea>
        </div>

        <div id="hero-contact-fields" class="hidden space-y-3 pt-3 border-t border-slate-200">
          <p class="text-xs font-bold text-unlu-green">Datos de Contacto Directo en la Cabecera:</p>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Correo Electrónico Oficial</label>
            <input type="email" id="input-hero-email" class="w-full border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-800" placeholder="planeamiento@unlu.edu.ar" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Teléfono Central e Anexo</label>
            <input type="text" id="input-hero-phone" class="w-full border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-800" placeholder="+54 (02323) 445100 · Interno 1200" />
          </div>
        </div>
      </div>

      <div class="p-6 border-t border-slate-100 flex gap-3">
        <button onclick="closeHeroEditModal()" class="flex-1 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-50">Cancelar</button>
        <button onclick="confirmHeroEdit()" class="flex-1 py-2.5 rounded-xl bg-unlu-green text-white font-bold text-sm hover:bg-unlu-green-dark shadow-xs">Guardar Cabecera</button>
      </div>
    </div>
  </div>
</div>

<!-- ===== MODAL DE EDICIÓN DE BLOQUE ===== -->
<div id="block-edit-modal" class="fixed inset-0 z-[400] hidden">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeBlockEdit()"></div>
  <div class="relative z-10 flex h-full items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-xl max-h-[90vh] flex flex-col overflow-hidden">
      <div class="p-6 border-b border-slate-200 flex items-center justify-between">
        <h2 id="block-edit-title" class="text-lg font-bold text-slate-900">Editar Bloque</h2>
        <button onclick="closeBlockEdit()" class="p-2 rounded-xl hover:bg-slate-100 text-slate-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div id="block-edit-fields" class="p-6 overflow-y-auto flex-1 space-y-4"></div>
      <div class="p-6 border-t border-slate-100 flex gap-3">
        <button onclick="closeBlockEdit()" class="flex-1 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-50">Cancelar</button>
        <button id="block-edit-confirm" class="flex-1 py-2.5 rounded-xl bg-unlu-green text-white font-bold text-sm hover:bg-unlu-green-dark">Confirmar</button>
      </div>
    </div>
  </div>
</div>

<!-- ===== MODAL VISTA PREVIA ===== -->
<div id="preview-modal" class="fixed inset-0 z-[200] hidden">
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closePreviewModal()"></div>
  <div class="relative h-full w-full flex flex-col">
    <div class="bg-slate-900 text-white px-6 py-3.5 flex items-center justify-between gap-4 shrink-0 border-b border-slate-700 z-10">
      <div class="flex items-center gap-3">
        <div class="flex gap-1.5">
          <span class="w-3 h-3 rounded-full bg-red-500"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
          <span class="w-3 h-3 rounded-full bg-green-500"></span>
        </div>
        <span class="text-sm font-bold">Vista Previa Real —</span>
        <span class="text-xs text-slate-400 font-mono" id="preview-url-label">secplaneamiento.unlu.edu.ar/autoevaluacion</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[11px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">No publicado aún</span>
        <button onclick="closePreviewModal()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
    </div>

    <div class="flex-1 overflow-auto bg-white">
      <!-- Mini-Navbar Simulada -->
