  }).join('');

  // Sub-bloques hijos para Secciones
  let childrenHtml = '';
  const children = block.children || [];
  if (block.type === 'seccion-badge' || children.length > 0) {
    childrenHtml = `<div class="mt-4 pt-4 border-t border-slate-200 space-y-3">
      <div class="flex items-center justify-between">
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Sub-bloques de Contenido (${children.length})</label>
