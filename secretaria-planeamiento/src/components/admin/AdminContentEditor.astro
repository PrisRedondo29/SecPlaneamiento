function updateBlockProp(idx, key, val) {
  if(!currentBlocks[idx]) return;
  if(!currentBlocks[idx].props) currentBlocks[idx].props = {};
  currentBlocks[idx].props[key] = val;
}

window.execInlineCmd = function(editorId, blockIdx, fieldKey, cmd, value = null) {
  const editor = document.getElementById(editorId);
  if(!editor) return;
  editor.focus();

  if(cmd === 'toggleGreen') {
    const sel = window.getSelection();
    if(sel && sel.rangeCount > 0) {
      const parent = sel.anchorNode?.parentElement;
      const isGreen = parent && (
        parent.style.color === 'rgb(0, 133, 65)' ||
        parent.style.color === '#008541' ||
        parent.getAttribute('color') === '#008541'
      );
      if(isGreen) {
        document.execCommand('removeFormat', false, null);
        document.execCommand('foreColor', false, '#374151');
      } else {
        document.execCommand('foreColor', false, '#008541');
      }
    } else {
      document.execCommand('foreColor', false, '#008541');
    }
  } else if(cmd === 'createLink') {
    const url = prompt('Ingrese la URL del enlace (ej: https://...):', 'https://');
    if(url) document.execCommand('createLink', false, url);
  } else {
    document.execCommand(cmd, false, value);
  }

  updateBlockProp(blockIdx, fieldKey, editor.innerHTML);
};

window.updateChildProp = function(parentIdx, childIdx, key, val) {
  if (!currentBlocks[parentIdx]?.children?.[childIdx]) return;
  if (!currentBlocks[parentIdx].children[childIdx].props) currentBlocks[parentIdx].children[childIdx].props = {};
  currentBlocks[parentIdx].children[childIdx].props[key] = val;
};

