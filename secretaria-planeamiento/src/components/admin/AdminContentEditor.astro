// =========================================================
// Helper interno para renderizar children (bloques anidados)
function renderChildren(children) {
  if (!Array.isArray(children) || children.length === 0) return '';
  return children.map(child => renderBlockHtml(child)).join('\n');
}

const CLIENT_BLOCK_REGISTRY = [
