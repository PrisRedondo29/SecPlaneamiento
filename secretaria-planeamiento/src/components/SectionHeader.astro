---
/**
 * Componente: SectionHeader
 * Encabezado de sección con badge dorado uppercase, título y descripción.
 * Estilo fiel al prototipo: badge dorado con texto en mayúsculas.
 */
interface Props {
  tag?: string;
  title: string;
  description?: string;
  centered?: boolean;
}

const { tag, title, description, centered = false } = Astro.props;
---

<div class:list={["mb-8 md:mb-12", centered ? "text-center max-w-3xl mx-auto" : "max-w-3xl"]}>
  {tag && (
    <span class="inline-block text-xs font-bold tracking-[0.15em] uppercase text-unlu-gold-dark mb-3">
      {tag}
    </span>
  )}
  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-gray-900">
    {title}
  </h2>
  {description && (
    <p class="mt-3 text-base sm:text-lg text-gray-600 leading-relaxed">
      {description}
    </p>
  )}
</div>
