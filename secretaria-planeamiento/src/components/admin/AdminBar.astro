---
/**
 * Componente: AdminBar
 * Barra flotante superior de administración en las páginas públicas.
 * Se muestra únicamente cuando existe una sesión activa simulada (unlu_admin_logged_in = true).
 */
interface Props {
  currentPageTitle?: string;
  currentPageId?: string;
}

const { currentPageTitle = "Página actual", currentPageId = "" } = Astro.props;
---

<!-- Barra superior flotante de Administración (Oculta por defecto hasta verificar localStorage en cliente) -->
<div id="unlu-admin-bar" class="hidden bg-slate-900 text-white text-xs border-b border-slate-700 shadow-md sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex flex-wrap items-center justify-between gap-3">
    <!-- Estado de sesión -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2 bg-slate-800 border border-slate-700 px-2.5 py-1 rounded-full">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-slate-300 font-medium">Sesión activa:</span>
        <span class="text-white font-semibold">usuplanea</span>
        <span class="bg-unlu-gold/20 text-unlu-gold border border-unlu-gold/40 text-[10px] uppercase font-bold px-1.5 py-0.5 rounded">Admin</span>
      </div>
      <span class="hidden sm:inline text-slate-500">|</span>
      <span class="hidden sm:inline text-slate-300">Viendo: <strong class="text-white font-medium">{currentPageTitle}</strong></span>
    </div>

    <!-- Acciones rápidas del Admin -->
    <div class="flex items-center gap-2">
      <!-- Botón Editar esta página -->
      <a
        href={`/admin?tab=editor&page=${currentPageId || "autoevaluacion"}`}
        class="inline-flex items-center gap-1.5 bg-unlu-green hover:bg-unlu-green-light text-white font-medium px-3 py-1 rounded-md shadow-xs transition-colors duration-150 border border-emerald-600/50"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span>Editar esta página</span>
      </a>

      <!-- Botón Ir al Dashboard -->
      <a
        href="/admin"
        class="inline-flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white font-medium px-3 py-1 rounded-md border border-slate-700 transition-colors duration-150"
      >
        <svg class="w-3.5 h-3.5 text-unlu-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
        </svg>
        <span>Dashboard</span>
      </a>

      <!-- Botón Cerrar Sesión -->
      <button
        id="logout-admin-bar-btn"
        title="Cerrar sesión de administrador"
        class="inline-flex items-center gap-1 text-slate-400 hover:text-red-400 hover:bg-slate-800 px-2 py-1 rounded transition-colors text-xs font-semibold"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span class="hidden sm:inline">Cerrar Sesión</span>
      </button>
    </div>
  </div>
</div>

<script>
  const adminBar = document.getElementById('unlu-admin-bar');
  const logoutBtn = document.getElementById('logout-admin-bar-btn');

  function checkAdminSession() {
    const isLoggedIn = localStorage.getItem('unlu_admin_logged_in') === 'true';
    if (isLoggedIn && adminBar) {
      adminBar.classList.remove('hidden');
    } else if (adminBar) {
      adminBar.classList.add('hidden');
    }
  }

  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      localStorage.removeItem('unlu_admin_logged_in');
      checkAdminSession();
      window.location.reload();
    });
  }

  // Verificar al cargar la vista
  checkAdminSession();
</script>
