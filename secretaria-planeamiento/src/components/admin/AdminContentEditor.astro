const BASE_PAGES = window.SERVER_BASE_PAGES || {};

// =========================================================
// ESTADO GLOBAL DEL EDITOR
// =========================================================
const LS_KEY = 'unlu_blocks_v30';
let currentPageKey = 'autoevaluacion';
let currentMeta = {};
let currentBlocks = [];
let editingBlockIndex = null;
let editingChildContext = null;
let currentInsertTargetParent = null;

function getSavedPages() { try { return JSON.parse(localStorage.getItem(LS_KEY)||'{}'); } catch(e) { return {}; } }
function savePages(data) { localStorage.setItem(LS_KEY, JSON.stringify(data)); }

function getPageData(key) {
  const saved = getSavedPages();
  if (saved[key]) {
    const data = saved[key];
    if (data.meta && Array.isArray(data.blocks)) return JSON.parse(JSON.stringify(data));
    if (Array.isArray(data)) {
      const base = BASE_PAGES[key] || {};
      return { meta: JSON.parse(JSON.stringify(base.meta || {})), blocks: JSON.parse(JSON.stringify(data)) };
    }
  }
  const base = BASE_PAGES[key];
  return base ? JSON.parse(JSON.stringify(base)) : { meta: {}, blocks: [] };
}

function generateId() { return 'blk-' + Math.random().toString(36).slice(2,9); }

function renderHeroDisplay() {
  const badgeEl = document.getElementById('hero-display-badge');
  const titleEl = document.getElementById('hero-display-title');
  const subtitleEl = document.getElementById('hero-display-subtitle');
  const contactExtras = document.getElementById('hero-display-contact-extras');
  const emailEl = document.getElementById('hero-display-email');
  const phoneEl = document.getElementById('hero-display-phone');

  if (badgeEl) badgeEl.textContent = currentMeta.heroBadge || '';
  if (titleEl) titleEl.textContent = currentMeta.heroTitle || '';
  if (subtitleEl) subtitleEl.textContent = currentMeta.heroSubtitle || '';

  if (currentPageKey === 'contacto' || currentMeta.email || currentMeta.telefono) {
    if (contactExtras) contactExtras.classList.remove('hidden');
    if (emailEl) emailEl.textContent = currentMeta.email || 'planeamiento@unlu.edu.ar';
    if (phoneEl) phoneEl.textContent = (currentMeta.telefono || '+54 (02323) 445100') + (currentMeta.interno ? ' (' + currentMeta.interno + ')' : '');
  } else {
    if (contactExtras) contactExtras.classList.add('hidden');
  }
}

function openHeroEditModal() {
  document.getElementById('input-hero-badge').value = currentMeta.heroBadge || '';
  document.getElementById('input-hero-title').value = currentMeta.heroTitle || '';
  document.getElementById('input-hero-subtitle').value = currentMeta.heroSubtitle || '';

  const contactFields = document.getElementById('hero-contact-fields');
  if (currentPageKey === 'contacto') {
    contactFields.classList.remove('hidden');
    document.getElementById('input-hero-email').value = currentMeta.email || 'planeamiento@unlu.edu.ar';
    document.getElementById('input-hero-phone').value = currentMeta.telefono || '+54 (02323) 445100';
  } else {
    contactFields.classList.add('hidden');
  }

  document.getElementById('hero-edit-modal').classList.remove('hidden');
}

function closeHeroEditModal() {
  document.getElementById('hero-edit-modal').classList.add('hidden');
}

function confirmHeroEdit() {
  currentMeta.heroBadge = document.getElementById('input-hero-badge').value;
  currentMeta.heroTitle = document.getElementById('input-hero-title').value;
  currentMeta.heroSubtitle = document.getElementById('input-hero-subtitle').value;

  if (currentPageKey === 'contacto') {
    currentMeta.email = document.getElementById('input-hero-email').value;
    currentMeta.telefono = document.getElementById('input-hero-phone').value;
  }

  const badge = document.getElementById('editing-badge');
  if (badge) badge.textContent = 'Editando: ' + (currentMeta.heroTitle || currentPageKey);

  renderHeroDisplay();
  closeHeroEditModal();
}

