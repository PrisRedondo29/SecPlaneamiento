                <button type="button" onclick="deleteChildSubBlock(${idx}, ${cIdx})" class="p-1 text-slate-400 hover:text-red-600 text-xs" title="Eliminar">🗑️</button>
              </div>
            </div>
            ${childInputHtml}
          </div>`;
        }).join('')}
      </div>

      <div class="pt-2 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-slate-600">➕ Agregar bloque interno:</span>
        <button type="button" onclick="addChildSubBlock(${idx}, 'texto-rico')" class="px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-unlu-green font-bold text-xs border border-emerald-200 transition-all">📝 Párrafo Word</button>
        <button type="button" onclick="addChildSubBlock(${idx}, 'titulo-bloque')" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200 transition-all">🔤 Título / Subtítulo</button>
        <button type="button" onclick="addChildSubBlock(${idx}, 'lista-puntos')" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200 transition-all">📋 Lista</button>
        <button type="button" onclick="addChildSubBlock(${idx}, 'link-card')" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200 transition-all">🔗 Tarjeta Enlace</button>
        <button type="button" onclick="addChildSubBlock(${idx}, 'cta-banner')" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200 transition-all">📄 Banner Documento</button>
      </div>
    </div>`;
  }

  return fieldsHtml + childrenHtml;
}

window.toggleBlockPreview = function(idx) {
  const fieldsBox = document.getElementById(`block-editor-fields-${idx}`);
  const previewBox = document.getElementById(`block-preview-box-${idx}`);
  const previewContent = document.getElementById(`block-preview-content-${idx}`);
  const toggleBtn = document.getElementById(`preview-toggle-btn-${idx}`);
  const toggleText = document.getElementById(`preview-toggle-text-${idx}`);

  if(!fieldsBox || !previewBox || !previewContent) return;

  const isPreviewing = !previewBox.classList.contains('hidden');

  if(isPreviewing) {
    previewBox.classList.add('hidden');
    fieldsBox.classList.remove('hidden');
    if(toggleText) toggleText.textContent = 'Vista previa';
    if(toggleBtn) {
      toggleBtn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
      toggleBtn.classList.add('bg-slate-100', 'text-slate-700', 'border-slate-200');
    }
  } else {
    const block = currentBlocks[idx];
    previewContent.innerHTML = renderBlockHtml(block);
    fieldsBox.classList.add('hidden');
    previewBox.classList.remove('hidden');
    if(toggleText) toggleText.textContent = 'Volver a editar';
    if(toggleBtn) {
      toggleBtn.classList.remove('bg-slate-100', 'text-slate-700', 'border-slate-200');
      toggleBtn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
    }
  }
};

// =========================================================
// RENDERIZAR LISTA DE BLOQUES EN EL EDITOR (EDICIÓN EN LÍNEA)
// =========================================================
function renderBlockList() {
  const container = document.getElementById('blocks-container');
  const countEl = document.getElementById('block-count');
  if(!container) return;
  if(countEl) countEl.textContent = currentBlocks.length;

  if(currentBlocks.length === 0) {
    container.innerHTML = `<div class="flex flex-col items-center justify-center py-14 text-slate-400 bg-white rounded-2xl border-2 border-dashed border-slate-200">
      <svg class="w-12 h-12 mb-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 01-2-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>
      <p class="font-semibold text-sm">Esta página no tiene bloques todavía</p>
      <p class="text-xs mt-1">Usá el botón "Insertar Bloque" para comenzar</p>
    </div>`;
    return;
  }

  container.innerHTML = currentBlocks.map((block, idx) => {
    const def = getBlockDef(block.type);
    const icon = def ? def.icon : '❓';
    const name = def ? def.name : block.type;
    const inlineFields = renderInlineFieldsForBlock(block, idx);

    return `<div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs group hover:border-unlu-green/50 hover:shadow-sm transition-all p-5 space-y-3" data-block-index="${idx}">
      <!-- Cabecera del bloque con controles de estructura y ojo de vista previa -->
      <div class="flex items-center justify-between pb-3 border-b border-slate-100 bg-slate-50/80 -mx-5 -mt-5 px-5 pt-3.5 mb-2">
        <div class="flex items-center gap-2">
          <span class="text-lg">${icon}</span>
          <div>
            <h3 class="text-xs font-bold text-slate-800">${name}</h3>
            <span class="text-[10px] text-slate-400 font-mono">Bloque #${idx+1}</span>
          </div>
        </div>
        <div class="flex items-center gap-1.5">
          <button type="button" onclick="toggleBlockPreview(${idx})" id="preview-toggle-btn-${idx}" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 font-bold text-xs border border-slate-200 transition-all cursor-pointer active:scale-95" title="Ver cómo queda este bloque">
            👁️ <span id="preview-toggle-text-${idx}">Vista previa</span>
          </button>
          ${idx > 0 ? `<button type="button" onclick="moveBlock(${idx}, -1)" class="p-1.5 rounded-lg hover:bg-slate-200 text-slate-600 font-bold transition-colors" title="Subir bloque">↑</button>` : ''}
          ${idx < currentBlocks.length-1 ? `<button type="button" onclick="moveBlock(${idx}, 1)" class="p-1.5 rounded-lg hover:bg-slate-200 text-slate-600 font-bold transition-colors" title="Bajar bloque">↓</button>` : ''}
          <button type="button" onclick="duplicateBlock(${idx})" class="p-1.5 rounded-lg hover:bg-blue-50 text-slate-500 hover:text-blue-600 transition-colors" title="Duplicar bloque">📋</button>
          <button type="button" onclick="deleteBlock(${idx})" class="p-1.5 rounded-lg hover:bg-red-50 text-slate-500 hover:text-red-600 transition-colors" title="Eliminar bloque">🗑️</button>
        </div>
      </div>
      <!-- Edición directa en la tarjeta del lienzo -->
      <div id="block-editor-fields-${idx}" class="inline-block-fields">${inlineFields}</div>

      <!-- CAJA DE VISTA PREVIA INDIVIDUAL (Revelada con el emoji de ojo 👁️) -->
      <div id="block-preview-box-${idx}" class="hidden mt-2 p-4 bg-slate-50 border border-slate-200 rounded-xl">
        <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-200">
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 flex items-center gap-1">👁️ Vista Previa del Bloque #${idx+1}</span>
          <span class="text-[10px] text-slate-400">Así se verá exactamente en la página pública</span>
        </div>
        <div id="block-preview-content-${idx}" class="bg-white p-4 rounded-xl shadow-2xs border border-slate-100"></div>
      </div>
    </div>`;
  }).join('');
}

// =========================================================
// OPERACIONES SOBRE BLOQUES Y BLOQUES HIJOS
// =========================================================
function moveBlock(idx, dir) {
  const newIdx = idx + dir;
  if(newIdx < 0 || newIdx >= currentBlocks.length) return;
  const tmp = currentBlocks[idx];
  currentBlocks[idx] = currentBlocks[newIdx];
  currentBlocks[newIdx] = tmp;
  renderBlockList();
}

function deleteBlock(idx) {
  if(!confirm('¿Eliminar este bloque?')) return;
  currentBlocks.splice(idx, 1);
  renderBlockList();
}

function duplicateBlock(idx) {
  const copy = JSON.parse(JSON.stringify(currentBlocks[idx]));
  copy.id = generateId();
  currentBlocks.splice(idx+1, 0, copy);
  renderBlockList();
}

function moveChildBlock(parentIdx, childIdx, dir) {
  const children = currentBlocks[parentIdx].children || [];
  const newIdx = childIdx + dir;
  if(newIdx < 0 || newIdx >= children.length) return;
  const tmp = children[childIdx];
  children[childIdx] = children[newIdx];
  children[newIdx] = tmp;
  renderBlockList();
}

function deleteChildBlock(parentIdx, childIdx) {
  if(!confirm('¿Eliminar este elemento de la sección?')) return;
  currentBlocks[parentIdx].children.splice(childIdx, 1);
  renderBlockList();
}

function duplicateChildBlock(parentIdx, childIdx) {
  const children = currentBlocks[parentIdx].children || [];
  const copy = JSON.parse(JSON.stringify(children[childIdx]));
  copy.id = generateId();
  children.splice(childIdx + 1, 0, copy);
  renderBlockList();
}

function openChildBlockEdit(parentIdx, childIdx) {
  editingBlockIndex = parentIdx;
  editingChildContext = { parentIdx, childIdx };
  const child = currentBlocks[parentIdx].children[childIdx];
  const def = getBlockDef(child.type);
  if(!def) return;

  const titleEl = document.getElementById('block-edit-title');
  const fieldsEl = document.getElementById('block-edit-fields');
  if(titleEl) titleEl.textContent = `✏️ Editar Elemento: ${def.name}`;

  renderFieldsForBlock(def, child.props, fieldsEl);
  document.getElementById('block-edit-modal').classList.remove('hidden');
}

function openInsertChildModal(parentIdx) {
  currentInsertTargetParent = parentIdx;
  openBlockLibrary();
}

// =========================================================
// LIBRERÍA DE BLOQUES (seleccionar tipo para insertar con vista previa)
// =========================================================
function getLibrarySamplePreview(def) {
  const sampleProps = {};
  if (def.fields) {
    def.fields.forEach(f => {
      sampleProps[f.key] = f.default || f.placeholder || (f.key === 'titulo' ? def.name : '');
    });
  }
  if (def.id === 'link-card') {
    sampleProps.text = 'Enlace de ejemplo a documento o sitio externo';
    sampleProps.url = '#';
  }
  if (def.id === 'cta-banner') {
    sampleProps.etiqueta = 'ETIQUETA DE DOCUMENTO';
    sampleProps.titulo = 'Título del documento o informe de ejemplo';
    sampleProps.url = '#';
    sampleProps.estilo = 'verde';
    sampleProps.tipoBoton = 'boton';
    sampleProps.textoBoton = 'Ver Documento';
  }
  if (def.id === 'titulo-bloque') {
    sampleProps.texto = 'Título de Sección de Ejemplo (H2 / H3)';
    sampleProps.nivel = 'h2';
  }
  if (def.id === 'texto-rico') {
    sampleProps.contenido = '<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. <strong>Texto en negrita</strong> de ejemplo.</p>';
  }
  if (def.id === 'lista-puntos') {
    sampleProps.items = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.\nSed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\nUt enim ad minim veniam, quis nostrud exercitation ullamco.';
  }
  if (def.id === 'seccion-badge') {
    sampleProps.badge = 'ETIQUETA DE SECCIÓN';
    sampleProps.titulo = 'Título de la Sección de Contenido';
    sampleProps.contenido = '<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>';
  }
  if (def.id === 'media-grid') {
    sampleProps.badge = 'COMUNICACIÓN';
    sampleProps.titulo = 'Medios / Entrevistas';
    sampleProps.items = JSON.stringify([{ tipo: 'youtube', id: 'dQw4w9WgXcQ', titulo: 'Entrevista institucional' }]);
  }
  if (def.id === 'card-atencion-mapa') {
    sampleProps.badge = 'ATENCIÓN AL PÚBLICO';
    sampleProps.horario = 'Lunes a viernes · 8:00 a 16:00 hs.';
    sampleProps.descripcion = 'Consultas presenciales en Mesa de Entradas.';
  }
  if (def.id === 'card-formulario-contacto') {
    sampleProps.badge = 'DEJANOS TU CONSULTA';
    sampleProps.titulo = 'Formulario Directo de Atención';
  }
  if (def.id === 'separador') {
    return '<div style="text-align:center;padding:0.75rem 0;color:#008541;font-weight:bold;">• • • • •</div>';
  }

  try {
    return def.render(sampleProps, { children: [] });
  } catch(e) {
    return `<div class="p-2 text-slate-400 text-xs">${def.description}</div>`;
  }
}

window.showBlockPreviewModal = function(typeId) {
  const def = getBlockDef(typeId);
  if (!def) return;

  const iconEl = document.getElementById('preview-modal-icon');
  const titleEl = document.getElementById('preview-modal-title');
  const descEl = document.getElementById('preview-modal-desc');
  const bodyEl = document.getElementById('preview-modal-body');
  const insertBtn = document.getElementById('preview-modal-insert-btn');

  if (iconEl) iconEl.textContent = def.icon || '📦';
  if (titleEl) titleEl.textContent = def.name;
  if (descEl) descEl.textContent = def.description;

  if (insertBtn) {
    insertBtn.onclick = function() {
      closeBlockPreviewModal();
      insertNewBlock(typeId);
    };
  }

  const sampleHtml = getLibrarySamplePreview(def);
  if (bodyEl) bodyEl.innerHTML = sampleHtml;

  const modal = document.getElementById('block-preview-modal');
  if (modal) modal.classList.remove('hidden');
};

window.closeBlockPreviewModal = function() {
  const modal = document.getElementById('block-preview-modal');
  if (modal) modal.classList.add('hidden');
};

function openBlockLibrary() {
  const grid = document.getElementById('block-library-grid');
  if(!grid) return;

  const modalTitle = document.querySelector('#block-library-modal h2');
  const modalDesc = document.querySelector('#block-library-modal p');

  let blocksToDisplay = CLIENT_BLOCK_REGISTRY;
  if (currentInsertTargetParent !== null) {
    const parentName = currentBlocks[currentInsertTargetParent]?.props?.titulo || 'Sección';
    if(modalTitle) modalTitle.textContent = `➕ Agregar Elemento Interno`;
    if(modalDesc) modalDesc.textContent = `Insertando dentro de: "${parentName}"`;
    blocksToDisplay = CLIENT_BLOCK_REGISTRY.filter(b => b.category === 'elementos' || !b.isContainer);
  } else {
    if(modalTitle) modalTitle.textContent = `Librería de Bloques`;
    if(modalDesc) modalDesc.textContent = `Seleccioná el tipo de bloque que querés insertar en la página`;
  }

  grid.innerHTML = blocksToDisplay.map(def => {
    return `<div class="bg-slate-50 hover:bg-slate-100/80 border border-slate-200 hover:border-slate-300 rounded-2xl p-4 transition-all flex items-center justify-between gap-3 group">
      <div class="flex items-start gap-3 cursor-pointer flex-1" onclick="insertNewBlock('${def.id}')">
        <span class="text-2xl mt-0.5">${def.icon}</span>
        <div>
          <p class="font-bold text-sm text-slate-900 group-hover:text-unlu-green transition-colors">${def.name}</p>
          <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">${def.description}</p>
        </div>
      </div>
      <div class="flex flex-col gap-1.5 items-end flex-shrink-0">
        <button type="button" onclick="event.stopPropagation(); showBlockPreviewModal('${def.id}')" class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-white hover:bg-slate-200 border border-slate-300 rounded-xl transition-all flex items-center gap-1 shadow-2xs cursor-pointer">
          👁️ Ver en grande
        </button>
        <button type="button" onclick="insertNewBlock('${def.id}')" class="px-3 py-1.5 text-xs font-bold text-white bg-unlu-green hover:bg-emerald-700 rounded-xl transition-all shadow-2xs cursor-pointer">
          ➕ Insertar
        </button>
      </div>
    </div>`;
  }).join('');

  document.getElementById('block-library-modal').classList.remove('hidden');
}

function closeBlockLibrary() {
  document.getElementById('block-library-modal').classList.add('hidden');
  currentInsertTargetParent = null;
}

function insertNewBlock(typeId) {
  const def = getBlockDef(typeId);
  if(!def) return;
  const defaultProps = {};
  def.fields.forEach(f => { defaultProps[f.key] = f.default || ''; });
  const newBlock = { id: generateId(), type: typeId, props: defaultProps };

  if (currentInsertTargetParent !== null) {
    const targetParent = currentInsertTargetParent;
    if(!currentBlocks[targetParent].children) currentBlocks[targetParent].children = [];
    currentBlocks[targetParent].children.push(newBlock);
    const newChildIdx = currentBlocks[targetParent].children.length - 1;
    currentInsertTargetParent = null;
    closeBlockLibrary();
    renderBlockList();
    openChildBlockEdit(targetParent, newChildIdx);
  } else {
    currentBlocks.push(newBlock);
    closeBlockLibrary();
    renderBlockList();
    openBlockEdit(currentBlocks.length - 1);
  }
}

// =========================================================
// EDITOR DE CAMPOS DE BLOQUE
// =========================================================
function renderFieldsForBlock(def, props, fieldsEl) {
  if(!fieldsEl) return;
  if(def.fields.length === 0) {
    fieldsEl.innerHTML = '<p class="text-slate-500 text-sm text-center py-8">Este bloque no tiene campos configurables.</p>';
    return;
  }

  fieldsEl.innerHTML = def.fields.map(field => {
    const val = (props||{})[field.key] !== undefined ? (props||{})[field.key] : (field.default||'');

    if(field.type === 'media-items') {
      let mediaItems = [];
      try { mediaItems = JSON.parse(val||'[]'); } catch(e) { mediaItems=[]; }

      function renderMediaItemCard(item, idx) {
        const tipo = item.tipo||'youtube';
        const youtubeFields = tipo==='youtube' ? `
          <div class="mt-2">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">ID del video de YouTube</label>
            <input type="text" data-media-key="id" value="${(item.id||'').replace(/"/g,'&quot;')}" class="w-full border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-unlu-green" placeholder="Ej: USB3P-5VUE8 (código en la URL ?v=)" />
          </div>` : '';
        const soundcloudFields = tipo==='soundcloud' ? `
          <div class="mt-2">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">URL completa de SoundCloud</label>
            <input type="url" data-media-key="url" value="${(item.url||'').replace(/"/g,'&quot;')}" class="w-full border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-unlu-green" placeholder="https://soundcloud.com/..." />
          </div>` : '';
        const linkFields = (tipo==='facebook'||tipo==='link') ? `
          <div class="mt-2">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">URL del enlace</label>
            <input type="url" data-media-key="url" value="${(item.url||'').replace(/"/g,'&quot;')}" class="w-full border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-unlu-green" placeholder="https://..." />
          </div>
          <div class="mt-2">
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Plataforma</label>
            <input type="text" data-media-key="plataforma" value="${(item.plataforma||'').replace(/"/g,'&quot;')}" class="w-full border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-unlu-green" placeholder="Ej: Prensa UNLu" />
          </div>` : '';

        const tipoIcons = { youtube: '▶️', soundcloud: '🎵', facebook: '🔵', link: '🔗' };
        return `<div class="border border-slate-200 rounded-xl overflow-hidden mb-3" data-media-item-index="${idx}">
          <div class="flex items-center justify-between px-3 py-2 bg-slate-50 border-b border-slate-200">
            <div class="flex items-center gap-2">
              <span class="text-sm">${tipoIcons[tipo]||'📎'}</span>
              <select data-media-key="tipo" onchange="updateMediaItemType(${idx}, this.value)" class="text-xs font-bold text-slate-700 bg-transparent border-0 focus:outline-none cursor-pointer">
                <option value="youtube" ${tipo==='youtube'?'selected':''}>YouTube</option>
                <option value="soundcloud" ${tipo==='soundcloud'?'selected':''}>SoundCloud</option>
                <option value="facebook" ${tipo==='facebook'?'selected':''}>Facebook / Red Social</option>
                <option value="link" ${tipo==='link'?'selected':''}>Otro enlace</option>
              </select>
            </div>
            <button type="button" onclick="removeMediaItem(${idx})" class="text-slate-400 hover:text-red-500 p-1 rounded transition-colors" title="Eliminar este ítem">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="p-3 space-y-2">
            <div>
              <label class="block text-[11px] font-bold text-slate-600 mb-1">Título</label>
              <input type="text" data-media-key="titulo" value="${(item.titulo||'').replace(/"/g,'&quot;')}" class="w-full border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-unlu-green" placeholder="Ej: ENTREVISTA MARIO OLORIZ" />
            </div>
            ${youtubeFields}${soundcloudFields}${linkFields}
          </div>
        </div>`;
      }

      window._mediaItemsState = JSON.parse(JSON.stringify(mediaItems));
      window.updateMediaItemType = function(idx, newTipo) { readMediaItemsFromDOM(); window._mediaItemsState[idx].tipo = newTipo; reRenderMediaItems(); };
      window.removeMediaItem = function(idx) { readMediaItemsFromDOM(); window._mediaItemsState.splice(idx,1); reRenderMediaItems(); };
      window.addMediaItem = function(tipo) { readMediaItemsFromDOM(); window._mediaItemsState.push({tipo, titulo:'', id:'', url:'', plataforma:''}); reRenderMediaItems(); document.getElementById('media-add-menu')?.classList.add('hidden'); };
      window.reRenderMediaItems = function() { const list = document.getElementById('media-items-list'); if(list) list.innerHTML = window._mediaItemsState.map((item,i) => renderMediaItemCard(item,i)).join(''); };
      window.readMediaItemsFromDOM = function() {
        const cards = document.querySelectorAll('[data-media-item-index]');
        cards.forEach((card, i) => {
          if(!window._mediaItemsState[i]) return;
          const get = (key) => { const el = card.querySelector(`[data-media-key="${key}"]`); return el ? el.value : ''; };
          window._mediaItemsState[i] = { tipo: get('tipo') || window._mediaItemsState[i].tipo, titulo: get('titulo'), id: get('id'), url: get('url'), plataforma: get('plataforma') };
        });
      };

      const initialCards = mediaItems.map((item,i) => renderMediaItemCard(item,i)).join('');
      return `<div data-field="${field.key}" data-field-type="media-items">
        <label class="block text-xs font-bold text-slate-700 mb-2">${field.label} <span class="font-normal text-slate-400">(${mediaItems.length})</span></label>
        <div id="media-items-list" class="space-y-0">${initialCards || '<p class="text-center text-xs text-slate-400 py-6 border border-dashed border-slate-300 rounded-xl">No hay ítems todavía.</p>'}</div>
        <div class="mt-3 relative">
          <button type="button" onclick="document.getElementById('media-add-menu').classList.toggle('hidden')" class="w-full flex items-center justify-center gap-2 border-2 border-dashed border-slate-300 hover:border-unlu-green text-slate-500 hover:text-unlu-green text-xs font-semibold py-2.5 rounded-xl transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Agregar ítem de medio
          </button>
          <div id="media-add-menu" class="hidden absolute bottom-full mb-2 left-0 right-0 bg-white border border-slate-200 rounded-xl shadow-xl p-2 z-10">
            <button onclick="addMediaItem('youtube')" class="flex items-center gap-2 w-full text-left text-xs font-semibold text-slate-700 hover:bg-red-50 hover:text-red-700 px-3 py-2 rounded-lg transition-colors">▶️ Video de YouTube</button>
            <button onclick="addMediaItem('soundcloud')" class="flex items-center gap-2 w-full text-left text-xs font-semibold text-slate-700 hover:bg-orange-50 hover:text-orange-700 px-3 py-2 rounded-lg transition-colors">🎵 Audio de SoundCloud</button>
            <button onclick="addMediaItem('facebook')" class="flex items-center gap-2 w-full text-left text-xs font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 px-3 py-2 rounded-lg transition-colors">🔵 Facebook / Red Social</button>
            <button onclick="addMediaItem('link')" class="flex items-center gap-2 w-full text-left text-xs font-semibold text-slate-700 hover:bg-slate-100 hover:text-slate-900 px-3 py-2 rounded-lg transition-colors">🔗 Otro enlace</button>
          </div>
        </div>
      </div>`;
    }

    if(field.type === 'wysiwyg' || field.type === 'richtext') {
      window.execWysiwygCmd = function(cmd, value = null) {
        const editor = document.getElementById(`wysiwyg-${field.key}`) || document.querySelector('[contenteditable="true"]');
        if(editor) editor.focus();
        document.execCommand(cmd, false, value);
      };

      return `<div data-field="${field.key}">
        <label class="block text-xs font-bold text-slate-700 mb-1.5">${field.label}</label>
        
        <div class="border border-slate-300 rounded-2xl overflow-hidden bg-white shadow-2xs">
          <!-- BARRA DE HERRAMIENTAS WORD / CKEDITOR (Con prevencion de des-foco) -->
          <div class="flex flex-wrap items-center gap-1 px-3 py-2 bg-slate-100 border-b border-slate-200 text-slate-700 select-none">
            <button type="button" onmousedown="event.preventDefault()" onclick="execWysiwygCmd('bold')" class="px-2.5 py-1 rounded-lg hover:bg-slate-200 font-bold text-xs cursor-pointer active:scale-95" title="Negrita (Ctrl+B)">B</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execWysiwygCmd('italic')" class="px-2.5 py-1 rounded-lg hover:bg-slate-200 italic font-serif text-xs cursor-pointer active:scale-95" title="Cursiva (Ctrl+I)">I</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execWysiwygCmd('underline')" class="px-2.5 py-1 rounded-lg hover:bg-slate-200 underline text-xs cursor-pointer active:scale-95" title="Subrayado (Ctrl+U)">U</button>

            <div class="h-4 w-px bg-slate-300 mx-1"></div>

            <button type="button" onmousedown="event.preventDefault()" onclick="execWysiwygCmd('formatBlock', '<h3>')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs font-bold text-slate-800 cursor-pointer active:scale-95" title="Título principal de sección">H2</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execWysiwygCmd('formatBlock', '<h4>')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs font-bold text-slate-600 cursor-pointer active:scale-95" title="Subtítulo">H3</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execWysiwygCmd('formatBlock', '<p>')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs text-slate-600 cursor-pointer active:scale-95" title="Párrafo normal">Párrafo</button>

            <div class="h-4 w-px bg-slate-300 mx-1"></div>

            <button type="button" onmousedown="event.preventDefault()" onclick="execWysiwygCmd('insertUnorderedList')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs font-bold cursor-pointer active:scale-95" title="Lista con viñetas">• Lista</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execWysiwygCmd('insertOrderedList')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs font-bold cursor-pointer active:scale-95" title="Lista numerada">1. Lista</button>

            <div class="h-4 w-px bg-slate-300 mx-1"></div>

            <button type="button" onmousedown="event.preventDefault()" onclick="execWysiwygCmd('foreColor', '#008541')" class="px-2 py-1 rounded-lg bg-emerald-100 hover:bg-emerald-200 text-unlu-green font-bold text-xs flex items-center gap-1 cursor-pointer active:scale-95" title="Aplicar color verde institucional">
              ✨ Texto Verde
            </button>

            <button type="button" onmousedown="event.preventDefault()" onclick="const url=prompt('Ingresá la URL del enlace:','https://'); if(url) execWysiwygCmd('createLink', url);" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs font-bold text-blue-700 cursor-pointer active:scale-95" title="Insertar Enlace">🔗 Enlace</button>
            <button type="button" onmousedown="event.preventDefault()" onclick="execWysiwygCmd('removeFormat')" class="px-2 py-1 rounded-lg hover:bg-slate-200 text-xs text-slate-400 cursor-pointer active:scale-95" title="Borrar formato del texto seleccionado">🧹 Limpiar</button>
          </div>

          <!-- ÁREA DE EDICIÓN CON FORMATO EN VIVO -->
          <div id="wysiwyg-${field.key}" contenteditable="true" class="p-4 min-h-[240px] max-h-[480px] overflow-y-auto text-sm leading-relaxed text-slate-800 focus:outline-none" data-field="${field.key}">${val}</div>
        </div>
        <p class="text-[11px] text-slate-400 mt-1.5">💡 Seleccioná cualquier texto y hacé clic en los botones de arriba para dar formato (Negrita, Cursiva, Listas, Títulos o Enlaces).</p>
      </div>`;
    }
    if(field.type === 'textarea') {
      return `<div>
        <label class="block text-xs font-bold text-slate-700 mb-1">${field.label}</label>
        <textarea data-field="${field.key}" class="w-full border border-slate-300 rounded-xl p-3 text-xs font-sans text-slate-800 focus:outline-none focus:ring-2 focus:ring-unlu-green resize-y min-h-[120px]" placeholder="${field.placeholder||''}">${val}</textarea>
      </div>`;
    }
    return `<div>
      <label class="block text-xs font-bold text-slate-700 mb-1">${field.label}</label>
      <input type="${field.type||'text'}" data-field="${field.key}" value="${(val+'').replace(/"/g,'&quot;')}" class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-unlu-green" placeholder="${field.placeholder||''}" />
    </div>`;
  }).join('');
}

function openBlockEdit(idx) {
  editingBlockIndex = idx;
  editingChildContext = null;
  const block = currentBlocks[idx];
  const def = getBlockDef(block.type);
  if(!def) return;

  const titleEl = document.getElementById('block-edit-title');
  const fieldsEl = document.getElementById('block-edit-fields');
  if(titleEl) titleEl.textContent = `✏️ Editar: ${def.name}`;

  renderFieldsForBlock(def, block.props, fieldsEl);
  document.getElementById('block-edit-modal').classList.remove('hidden');
}

function closeBlockEdit() {
  document.getElementById('block-edit-modal').classList.add('hidden');
  editingBlockIndex = null;
  editingChildContext = null;
}

function confirmBlockEdit() {
  if(editingBlockIndex === null) return;
  const block = currentBlocks[editingBlockIndex];
  const def = getBlockDef(block.type);
  if(!def) return;

  const fieldsEl = document.getElementById('block-edit-fields');
  if(!fieldsEl) return;

  def.fields.forEach(field => {
    if(field.type === 'media-items') {
      if(window.readMediaItemsFromDOM) window.readMediaItemsFromDOM();
      const cleaned = (window._mediaItemsState||[]).map(item => {
        const out = { tipo: item.tipo, titulo: item.titulo };
        if(item.tipo==='youtube') { out.id = item.id; }
        else { out.url = item.url; if(item.plataforma) out.plataforma = item.plataforma; }
        return out;
      });
      block.props[field.key] = JSON.stringify(cleaned);
    } else if(field.type === 'wysiwyg' || field.type === 'richtext') {
      const el = document.getElementById(`wysiwyg-${field.key}`);
      if(el) block.props[field.key] = el.innerHTML;
    } else {
      const el = fieldsEl.querySelector(`[data-field="${field.key}"]`);
      if(el) block.props[field.key] = el.value;
    }
  });

  closeBlockEdit();
  renderBlockList();
}

// =========================================================
// VISTA PREVIA
// =========================================================
function openPreviewModal() {
  const pageBase = BASE_PAGES[currentPageKey];
  const meta = pageBase ? pageBase.meta : {};

  // Rellenar hero
  const heroTitle = document.getElementById('preview-hero-title');
  const heroBadge = document.getElementById('preview-hero-badge');
  const heroSubtitle = document.getElementById('preview-hero-subtitle');
  const previewUrl = document.getElementById('preview-url-label');
  const previewMenu = document.getElementById('preview-menu-label');

  if(heroTitle) heroTitle.textContent = meta.heroTitle || '';
  if(heroBadge) heroBadge.textContent = meta.heroBadge || '';
  if(heroSubtitle) heroSubtitle.textContent = meta.heroSubtitle || '';
  if(previewUrl) previewUrl.textContent = meta.slug || '';
  if(previewMenu) previewMenu.textContent = meta.heroTitle || '';

  // Renderizar bloques
  const content = document.getElementById('preview-blocks-content');
  if(content) {
    content.innerHTML = currentBlocks.map(b => renderBlockHtml(b)).join('\n');
  }

  document.getElementById('preview-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}

function closePreviewModal() {
  document.getElementById('preview-modal').classList.add('hidden');
  document.body.style.overflow = '';
}

// =========================================================
// GUARDAR Y REINICIAR
// =========================================================
function savePage() {
  const saved = getSavedPages();
  saved[currentPageKey] = {
    meta: JSON.parse(JSON.stringify(currentMeta)),
    blocks: JSON.parse(JSON.stringify(currentBlocks))
  };
  savePages(saved);
  const el = document.getElementById('last-edit-time');
  if(el) el.textContent = 'Hoy ' + new Date().toLocaleTimeString('es-AR',{hour:'2-digit',minute:'2-digit'});
  showToast('toast-save');
}

function resetPage() {
  if(!confirm('¿Restaurar la cabecera y bloques originales de esta página? Se perderán los cambios locales.')) return;
  const saved = getSavedPages();
  delete saved[currentPageKey];
  savePages(saved);
  loadPage(currentPageKey);
  showToast('toast-reset');
}

function loadPage(key) {
  currentPageKey = key;
  const pageData = getPageData(key);
  currentMeta = pageData.meta || {};
  currentBlocks = pageData.blocks || [];

  const badge = document.getElementById('editing-badge');
  if(badge) badge.textContent = 'Editando: ' + (currentMeta.heroTitle || key);

  renderHeroDisplay();
  renderBlockList();
}

// =========================================================
// TOAST
// =========================================================
function showToast(id) {
  document.querySelectorAll('[id^="toast-"]').forEach(t => {
    t.classList.add('opacity-0','translate-y-8','pointer-events-none');
    t.classList.remove('opacity-100','translate-y-0');
  });
  const toast = document.getElementById(id);
  if(!toast) return;
  toast.classList.remove('opacity-0','translate-y-8','pointer-events-none');
  toast.classList.add('opacity-100','translate-y-0');
  setTimeout(() => {
    toast.classList.add('opacity-0','translate-y-8','pointer-events-none');
    toast.classList.remove('opacity-100','translate-y-0');
  }, 4000);
}

// =========================================================
// INICIALIZACIÓN
// =========================================================
document.addEventListener('DOMContentLoaded', () => {
  const urlParams = new URLSearchParams(window.location.search);
  const pageParam = urlParams.get('page');
  if(pageParam && BASE_PAGES[pageParam]) {
    const sel = document.getElementById('page-selector');
    if(sel) sel.value = pageParam;
    currentPageKey = pageParam;
  }
  loadPage(currentPageKey);

  document.getElementById('page-selector')?.addEventListener('change', e => loadPage(e.target.value));
  document.getElementById('add-block-btn')?.addEventListener('click', openBlockLibrary);
  document.getElementById('save-page-btn')?.addEventListener('click', savePage);
  document.getElementById('reset-btn')?.addEventListener('click', resetPage);
  document.getElementById('preview-btn')?.addEventListener('click', openPreviewModal);
  document.getElementById('block-edit-confirm')?.addEventListener('click', confirmBlockEdit);
  document.addEventListener('keydown', e => { if(e.key==='Escape') { closePreviewModal(); closeBlockLibrary(); closeBlockEdit(); } });
});
</script>
