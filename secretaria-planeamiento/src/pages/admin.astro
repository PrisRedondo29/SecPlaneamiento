---
/**
 * Página: Dashboard de Administración (/admin)
 * Panel de control e Inicio de Sesión para usuplanea (Secretaría de Planeamiento UNLu).
 * Simulación de Autenticación con Usuario: admin / Contraseña: admin.
 */
import Layout from "../layouts/Layout.astro";
import AdminOverview from "../components/admin/AdminOverview.astro";
import AdminContentEditor from "../components/admin/AdminContentEditor.astro";
import AdminFileManager from "../components/admin/AdminFileManager.astro";
import AdminSiteManager from "../components/admin/AdminSiteManager.astro";
import AdminProfile from "../components/admin/AdminProfile.astro";
---

<Layout title="Dashboard de Administración · Secretaría de Planeamiento UNLu">

  <!-- VISTA 1: INICIO DE SESIÓN SIMULADO (Se muestra cuando unlu_admin_logged_in != true) -->
  <div id="login-view" class="hidden min-h-screen bg-slate-900 flex flex-col items-center justify-center p-4 relative overflow-hidden">
    
    <!-- Fondo decorativo con escudo difuminado -->
    <div class="absolute -right-20 -bottom-20 opacity-5 pointer-events-none">
      <img src="/escudo.svg" alt="" class="w-96 h-96 invert" />
    </div>

    <!-- Contenedor Tarjeta de Login -->
    <div class="max-w-md w-full bg-white rounded-3xl shadow-2xl overflow-hidden relative z-10 border border-slate-200">
      
      <!-- Encabezado Institucional Verde UNLu -->
      <div class="bg-gradient-to-br from-unlu-green-dark to-unlu-green p-8 text-center text-white relative">
        <img src="/escudo.svg" alt="Escudo UNLu" class="w-16 h-16 mx-auto mb-3 rounded-full border-2 border-unlu-gold/40 shadow-md bg-white p-1" />
        <h1 class="text-xl font-bold tracking-tight font-sans">Secretaría de Planeamiento</h1>
        <p class="text-xs text-emerald-100 font-medium uppercase tracking-wider mt-1">Portal de Administración del Sitio</p>
      </div>

      <!-- Formulario de Credenciales -->
      <form id="admin-login-form" class="p-6 sm:p-8 space-y-5">
        
        <!-- Banner Informativo de Acceso Demo -->
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-3.5 flex items-start gap-3 text-xs text-amber-800">
          <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <span class="font-bold">Acceso de Simulación Activo:</span>
            <p class="mt-0.5">Ingresa con Usuario: <strong class="underline">admin</strong> y Contraseña: <strong class="underline">admin</strong></p>
          </div>
        </div>

        <!-- Alerta de Error (oculta por defecto) -->
        <div id="login-error-alert" class="hidden bg-red-50 border border-red-200 rounded-2xl p-3 text-xs text-red-700 font-medium text-center">
          ⚠️ Usuario o contraseña incorrectos. Usa <strong>admin</strong> / <strong>admin</strong>.
        </div>

        <!-- Campo Usuario -->
        <div>
          <label for="login-username" class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">
            Usuario
          </label>
          <div class="relative">
            <input
              type="text"
              id="login-username"
              value="admin"
              required
              placeholder="Ingresa tu usuario..."
              class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-10 pr-4 py-3 text-sm text-slate-900 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green focus:border-unlu-green outline-none transition-all"
            />
            <svg class="w-5 h-5 text-slate-400 absolute left-3 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
        </div>

        <!-- Campo Contraseña -->
        <div>
          <label for="login-password" class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">
            Contraseña
          </label>
          <div class="relative">
            <input
              type="password"
              id="login-password"
              value="admin"
              required
              placeholder="••••••••"
              class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-10 pr-4 py-3 text-sm text-slate-900 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green focus:border-unlu-green outline-none transition-all"
            />
            <svg class="w-5 h-5 text-slate-400 absolute left-3 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
        </div>

        <!-- Botón Entrar -->
        <button
          type="submit"
          class="w-full bg-unlu-green hover:bg-unlu-green-dark text-white font-bold text-sm py-3 rounded-xl shadow-lg transition-all transform active:scale-98 cursor-pointer flex items-center justify-center gap-2 mt-2"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
          </svg>
          <span>Iniciar Sesión en el Dashboard</span>
        </button>

        <div class="text-center pt-2">
          <a href="/" class="text-xs text-slate-500 hover:text-unlu-green font-medium">← Volver al sitio público</a>
        </div>

      </form>
    </div>

  </div>

  <!-- VISTA 2: DASHBOARD COMPLETO (Se muestra cuando unlu_admin_logged_in == true) -->
  <div id="dashboard-view" class="hidden min-h-screen bg-slate-100 flex flex-col md:flex-row antialiased">
    
    <!-- Sidebar de Navegación Lateral -->
    <aside class="w-full md:w-72 bg-slate-900 text-white shrink-0 border-r border-slate-800 flex flex-col justify-between min-h-screen shadow-xl z-20">
      
      <!-- Top Branding Sidebar -->
      <div>
        <div class="p-6 border-b border-slate-800 flex items-center justify-between">
          <a href="/" class="flex items-center gap-3 group">
            <img src="/escudo.svg" alt="Escudo UNLu" class="w-10 h-10 rounded-full border border-unlu-gold/40 shadow-sm" />
            <div class="flex flex-col">
              <span class="font-bold text-sm text-white tracking-tight leading-tight">Sec. Planeamiento</span>
              <span class="text-[10px] uppercase tracking-widest text-unlu-gold font-semibold">Universidad Nacional de Luján</span>
            </div>
          </a>
        </div>

        <!-- Perfil rápido en sidebar -->
        <div class="px-6 py-4 bg-slate-950/60 border-b border-slate-800/80 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-unlu-green text-white font-bold text-xs flex items-center justify-center shadow-xs">
              UP
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-bold text-white">usuplanea</span>
              <span class="text-[10px] text-emerald-400 font-medium flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Administrador
              </span>
            </div>
          </div>

          <a href="/admin?tab=profile" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800" title="Ajustes de mi cuenta">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </a>
        </div>

        <!-- Links de Navegación del Dashboard -->
        <nav class="p-4 space-y-1.5">
          
          <button
            onclick="window.switchTab('overview')"
            data-tab="overview"
            class="nav-tab-btn active w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all text-left"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            <span>Resumen del Sitio</span>
          </button>

          <button
            onclick="window.switchTab('editor')"
            data-tab="editor"
            class="nav-tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all text-left"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Editor de Contenido</span>
          </button>

          <button
            onclick="window.switchTab('files')"
            data-tab="files"
            class="nav-tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all text-left"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
            </svg>
            <span>Explorador IMCE / Archivos</span>
          </button>

          <button
            onclick="window.switchTab('site')"
            data-tab="site"
            class="nav-tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all text-left"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <span>Estructura del Sitio</span>
          </button>

          <button
            onclick="window.switchTab('profile')"
            data-tab="profile"
            class="nav-tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all text-left"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>Mi Cuenta (usuplanea)</span>
          </button>

        </nav>
      </div>

      <!-- Bottom Sidebar Action -->
      <div class="p-4 border-t border-slate-800 space-y-2">
        <a
          href="/"
          class="w-full inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white font-medium text-xs py-2.5 rounded-xl transition-colors border border-slate-700"
        >
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Volver al Sitio Público</span>
        </a>

        <button
          id="logout-sidebar-btn"
          class="w-full inline-flex items-center justify-center gap-2 bg-red-950/40 hover:bg-red-900/60 text-red-300 font-semibold text-xs py-2.5 rounded-xl transition-colors border border-red-800/40"
        >
          <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span>Cerrar Sesión</span>
        </button>
      </div>

    </aside>

    <!-- Área de Contenido Principal -->
    <main class="flex-1 p-4 sm:p-8 max-w-7xl mx-auto w-full">
      
      <!-- Vista 1: Resumen (Overview) -->
      <div id="tab-content-overview" class="tab-pane">
        <AdminOverview />
      </div>

      <!-- Vista 2: Editor de Contenidos -->
      <div id="tab-content-editor" class="tab-pane hidden">
        <AdminContentEditor />
      </div>

      <!-- Vista 3: Explorador de Archivos IMCE -->
      <div id="tab-content-files" class="tab-pane hidden">
        <AdminFileManager />
      </div>

      <!-- Vista 4: Administración del Sitio -->
      <div id="tab-content-site" class="tab-pane hidden">
        <AdminSiteManager />
      </div>

      <!-- Vista 5: Mi Cuenta / Perfil -->
      <div id="tab-content-profile" class="tab-pane hidden">
        <AdminProfile />
      </div>

    </main>

  </div>

</Layout>

<style>
  /* Estilos para pestañas del Sidebar */
  .nav-tab-btn {
    color: #94a3b8;
  }
  .nav-tab-btn:hover {
    color: #ffffff;
    background-color: rgba(30, 41, 59, 0.8);
  }
  .nav-tab-btn.active {
    color: #ffffff;
    background-color: #008541;
    font-weight: 700;
    box-shadow: 0 4px 6px -1px rgba(0, 133, 65, 0.25);
  }
</style>

<script is:inline>
  const loginView = document.getElementById('login-view');
  const dashboardView = document.getElementById('dashboard-view');
  const loginForm = document.getElementById('admin-login-form');
  const loginErrorAlert = document.getElementById('login-error-alert');
  const logoutSidebarBtn = document.getElementById('logout-sidebar-btn');

  // Evaluar estado de inicio de sesión
  function updateAuthState() {
    const isLoggedIn = localStorage.getItem('unlu_admin_logged_in') === 'true';

    if (isLoggedIn) {
      if (loginView) loginView.classList.add('hidden');
      if (dashboardView) dashboardView.classList.remove('hidden');

      // Cargar pestaña especificada por URL
      const params = new URLSearchParams(window.location.search);
      const tab = params.get('tab') || 'overview';
      const page = params.get('page');
      window.switchTab(tab, page);
    } else {
      if (loginView) loginView.classList.remove('hidden');
      if (dashboardView) dashboardView.classList.add('hidden');
    }
  }

  // Manejar envío de formulario de Login
  if (loginForm) {
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const user = document.getElementById('login-username').value.trim();
      const pass = document.getElementById('login-password').value.trim();

      if (user === 'admin' && pass === 'admin') {
        localStorage.setItem('unlu_admin_logged_in', 'true');
        if (loginErrorAlert) loginErrorAlert.classList.add('hidden');
        updateAuthState();
      } else {
        if (loginErrorAlert) loginErrorAlert.classList.remove('hidden');
      }
    });
  }

  // Manejar cierre de sesión
  if (logoutSidebarBtn) {
    logoutSidebarBtn.addEventListener('click', () => {
      localStorage.removeItem('unlu_admin_logged_in');
      updateAuthState();
    });
  }

  window.switchTab = function(tabName, pageParam) {
    const panes = document.querySelectorAll('.tab-pane');
    panes.forEach(pane => pane.classList.add('hidden'));

    const btns = document.querySelectorAll('.nav-tab-btn');
    btns.forEach(btn => btn.classList.remove('active'));

    const targetPane = document.getElementById('tab-content-' + tabName);
    const targetBtn = document.querySelector(`.nav-tab-btn[data-tab="${tabName}"]`);

    if (targetPane) targetPane.classList.remove('hidden');
    if (targetBtn) targetBtn.classList.add('active');

    if (tabName === 'editor' && pageParam) {
      const pageSelector = document.getElementById('page-selector');
      if (pageSelector) {
        pageSelector.value = pageParam;
        pageSelector.dispatchEvent(new Event('change'));
      }
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // Inicializar estado al cargar
  updateAuthState();
</script>
