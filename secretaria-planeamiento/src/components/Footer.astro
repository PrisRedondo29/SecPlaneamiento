---
/**
 * Componente: Footer Institucional
 * Pie de página con fondo verde institucional, 3 columnas: info, secciones y contacto.
 * Diseño fiel al prototipo aprobado.
 */
---

<footer class="bg-unlu-green-dark text-white border-t-4 border-unlu-gold">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 lg:py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-10 lg:gap-16">
      
      <!-- Columna 1: Información Institucional -->
      <div class="space-y-2 sm:space-y-3 md:col-span-1">
        <div class="flex items-center gap-3">
          <img src="/escudo.svg" alt="Escudo UNLu" class="w-8 h-8 sm:w-10 sm:h-10 rounded-full border border-unlu-gold/30 shrink-0" />
          <div>
            <span class="font-bold text-white block text-sm sm:text-base">Secretaría de Planeamiento</span>
            <span class="text-xs text-white/70 block sm:hidden">Universidad Nacional de Luján</span>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-white/70 leading-relaxed hidden sm:block">
          Rectorado de la Universidad Nacional de Luján. Autoevaluación, evaluación externa y planificación institucional al servicio de la comunidad universitaria.
        </p>
      </div>

      <!-- Contenedor 2 columnas en móvil para Secciones y Contacto -->
      <div class="grid grid-cols-2 gap-4 sm:gap-6 md:col-span-2 md:grid-cols-2">
        <!-- Columna 2: Secciones -->
        <div>
          <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-unlu-gold-light mb-2 sm:mb-4">Secciones</h3>
          <ul class="space-y-1.5 sm:space-y-2.5 text-xs sm:text-sm">
            <li>
              <a href="/la-secretaria" class="text-white/80 hover:text-unlu-gold-light transition-colors">
                La Secretaría
              </a>
            </li>
            <li>
              <a href="/autoevaluacion" class="text-white/80 hover:text-unlu-gold-light transition-colors">
                Autoevaluación
              </a>
            </li>
            <li>
              <a href="/plan-desarrollo" class="text-white/80 hover:text-unlu-gold-light transition-colors">
                Plan de Desarrollo
              </a>
            </li>
          </ul>
        </div>

        <!-- Columna 3: Contacto -->
        <div>
          <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-unlu-gold-light mb-2 sm:mb-4">Contacto</h3>
          <ul class="space-y-2 sm:space-y-3 text-xs sm:text-sm">
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-unlu-gold-light shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              <a href="mailto:planeamiento@unlu.edu.ar" class="text-white/80 hover:text-unlu-gold-light transition-colors truncate">
                planeamiento@unlu.edu.ar
              </a>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-unlu-gold-light shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              <a href="tel:+5402323445100" class="text-white/80 hover:text-unlu-gold-light transition-colors">
                +54 (02323) 445100
              </a>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-unlu-gold-light shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
              </svg>
              <a href="https://guiatel.unlu.edu.ar/" target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-unlu-gold-light transition-colors">
                Guía para Internos
              </a>
            </li>
          </ul>
        </div>
      </div>

    </div>

    <!-- Copyright -->
    <div class="border-t border-white/15 mt-5 sm:mt-8 pt-4 text-center text-[11px] sm:text-xs text-white/50">
      <p>© {new Date().getFullYear()} Universidad Nacional de Luján · Secretaría de Planeamiento</p>
    </div>
  </div>
</footer>
