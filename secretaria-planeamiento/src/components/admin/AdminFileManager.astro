---
/**
 * Componente: AdminFileManager
 * Explorador de Documentos y Archivos Multimedia.
 * Reemplazo moderno, rápido y elegante del antiguo explorador IMCE de Drupal.
 */
---

<div class="space-y-6">
  <!-- Header de la Sección -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
        <a href="/admin" class="hover:text-unlu-green">Dashboard</a>
        <span>/</span>
        <span class="text-slate-900 font-bold">Explorador de Documentos</span>
      </div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900 font-sans">
        Archivos Multimedia e Informes IMCE
      </h1>
      <p class="text-xs text-slate-500 mt-0.5">
        Subida, gestión y copiado de URLs para imágenes y documentos oficiales.
      </p>
    </div>

    <!-- Botón de Subida Principal -->
    <div class="flex items-center gap-3">
      <button
        id="trigger-upload-modal-btn"
        class="inline-flex items-center gap-2 bg-unlu-green hover:bg-unlu-green-dark text-white font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl shadow-md transition-transform active:scale-95 cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        <span>Subir Archivo al Servidor</span>
      </button>
    </div>
  </div>

  <!-- Zona Drag & Drop de Subida Simulada -->
  <div
    id="drag-drop-zone"
    class="border-2 border-dashed border-slate-300 hover:border-unlu-green bg-slate-50/50 hover:bg-emerald-50/30 rounded-2xl p-6 sm:p-8 text-center transition-all cursor-pointer group"
  >
    <div class="max-w-md mx-auto space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-center justify-center mx-auto text-unlu-green group-hover:scale-110 transition-transform">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-bold text-slate-800">
          Arrastra y suelta aquí tus archivos o <span class="text-unlu-green underline">examina tu equipo</span>
        </p>
        <p class="text-xs text-slate-500 mt-1">Soporta PDF, PNG, JPG, DOCX de hasta 20 MB por archivo</p>
      </div>
      <input type="file" id="file-input-hidden" class="hidden" multiple />
    </div>
  </div>

  <!-- Barra de Filtros, Búsqueda y Modos de Vista -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex flex-col md:flex-row items-center justify-between gap-4">
    
    <!-- Filtros de Categoría -->
    <div class="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto pb-1 md:pb-0">
      <button class="filter-chip active bg-unlu-green text-white font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors">
        Todos (7)
      </button>
      <button class="filter-chip bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors">
        Imágenes (4)
      </button>
      <button class="filter-chip bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors">
        Documentos PDF (2)
      </button>
      <button class="filter-chip bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors">
        Otros (1)
      </button>
    </div>

    <!-- Buscador y Selector de Vista -->
    <div class="flex items-center justify-between md:justify-end gap-3 w-full md:w-auto">
      <div class="relative w-full sm:w-64">
        <input
          type="text"
          id="file-search-input"
          placeholder="Buscar archivo por nombre..."
          class="w-full bg-slate-100 border border-slate-300 rounded-xl pl-9 pr-3 py-1.5 text-xs text-slate-800 focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <div class="flex items-center border border-slate-300 rounded-xl p-1 bg-slate-100 shrink-0">
        <button id="view-mode-grid-btn" class="p-1 rounded-lg bg-white shadow-xs text-slate-800" title="Vista en Grilla">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
        </button>
        <button id="view-mode-list-btn" class="p-1 rounded-lg text-slate-500 hover:text-slate-900" title="Vista en Lista Detallada">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

  </div>

  <!-- Grilla de Archivos -->
  <div id="files-container-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
    
    <!-- Archivo 1: PDF Informe 2025 -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-all overflow-hidden group">
      <div class="h-32 bg-slate-100 flex items-center justify-center relative p-4 group-hover:bg-amber-50/50 transition-colors">
        <div class="w-14 h-14 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center font-bold text-xs uppercase shadow-sm">
          PDF
        </div>
        <span class="absolute top-2 right-2 text-[10px] font-bold bg-white/90 text-slate-700 px-2 py-0.5 rounded-md border border-slate-200">
          174.64 KB
        </span>
      </div>
      <div class="p-4 space-y-2">
        <h3 class="text-xs font-bold text-slate-900 truncate" title="Informe Preliminar 2025 IPLAN-CA7.pdf">
          Informe Preliminar 2025 IPLAN-CA7.pdf
        </h3>
        <div class="text-[11px] text-slate-500 flex items-center justify-between">
          <span>22/05/2025</span>
          <span class="font-mono">Documento</span>
        </div>
        <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
          <button
            onclick="navigator.clipboard.writeText('/files/Informe_Preliminar_2025.pdf'); alert('URL copiada al portapapeles!');"
            class="w-full text-center text-xs font-semibold text-unlu-green hover:bg-emerald-50 py-1.5 rounded-lg border border-emerald-200 transition-colors"
          >
            Copiar Link
          </button>
        </div>
      </div>
    </div>

    <!-- Archivo 2: Imagen Autoevaluación -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-all overflow-hidden group">
      <div class="h-32 bg-emerald-950 flex items-center justify-center relative overflow-hidden">
        <img src="/escudo.svg" alt="" class="w-20 h-20 opacity-40 hover:opacity-80 transition-opacity" />
        <span class="absolute top-2 right-2 text-[10px] font-bold bg-slate-900/80 text-white px-2 py-0.5 rounded-md">
          1200x300 px
        </span>
      </div>
      <div class="p-4 space-y-2">
        <h3 class="text-xs font-bold text-slate-900 truncate" title="Autoevaluación Institucional 2022.png">
          Autoevaluación Institucional 2022.png
        </h3>
        <div class="text-[11px] text-slate-500 flex items-center justify-between">
          <span>11/02/2025</span>
          <span class="font-mono">107.81 KB</span>
        </div>
        <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
          <button
            onclick="navigator.clipboard.writeText('/files/Autoevaluacion_2022.png'); alert('URL copiada al portapapeles!');"
            class="w-full text-center text-xs font-semibold text-unlu-green hover:bg-emerald-50 py-1.5 rounded-lg border border-emerald-200 transition-colors"
          >
            Copiar Link
          </button>
        </div>
      </div>
    </div>

    <!-- Archivo 3: Formato Proyectos PDF -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-all overflow-hidden group">
      <div class="h-32 bg-slate-100 flex items-center justify-center relative p-4 group-hover:bg-amber-50/50 transition-colors">
        <div class="w-14 h-14 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center font-bold text-xs uppercase shadow-sm">
          PDF
        </div>
        <span class="absolute top-2 right-2 text-[10px] font-bold bg-white/90 text-slate-700 px-2 py-0.5 rounded-md border border-slate-200">
          93.44 KB
        </span>
      </div>
      <div class="p-4 space-y-2">
        <h3 class="text-xs font-bold text-slate-900 truncate" title="Formato para la Presentación de Proyectos.pdf">
          Formato para la Presentación de Proyectos.pdf
        </h3>
        <div class="text-[11px] text-slate-500 flex items-center justify-between">
          <span>10/02/2025</span>
          <span class="font-mono">Documento</span>
        </div>
        <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
          <button
            onclick="navigator.clipboard.writeText('/files/Formato_Presentacion_Proyectos.pdf'); alert('URL copiada al portapapeles!');"
            class="w-full text-center text-xs font-semibold text-unlu-green hover:bg-emerald-50 py-1.5 rounded-lg border border-emerald-200 transition-colors"
          >
            Copiar Link
          </button>
        </div>
      </div>
    </div>

    <!-- Archivo 4: Banner JPG -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-all overflow-hidden group">
      <div class="h-32 bg-slate-800 flex items-center justify-center relative overflow-hidden">
        <span class="text-unlu-gold font-bold text-xs uppercase tracking-widest">Banner UNLu</span>
        <span class="absolute top-2 right-2 text-[10px] font-bold bg-slate-900/80 text-white px-2 py-0.5 rounded-md">
          1200x119 px
        </span>
      </div>
      <div class="p-4 space-y-2">
        <h3 class="text-xs font-bold text-slate-900 truncate" title="banner.jpg">
          banner.jpg
        </h3>
        <div class="text-[11px] text-slate-500 flex items-center justify-between">
          <span>12/07/2023</span>
          <span class="font-mono">24.29 KB</span>
        </div>
        <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
          <button
            onclick="navigator.clipboard.writeText('/files/banner.jpg'); alert('URL copiada al portapapeles!');"
            class="w-full text-center text-xs font-semibold text-unlu-green hover:bg-emerald-50 py-1.5 rounded-lg border border-emerald-200 transition-colors"
          >
            Copiar Link
          </button>
        </div>
      </div>
    </div>

    <!-- Archivo 5: Auto Julio 2023 JPG -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-all overflow-hidden group">
      <div class="h-32 bg-slate-200 flex items-center justify-center relative overflow-hidden">
        <span class="text-slate-600 font-bold text-xs uppercase">Imagen Adjunta</span>
        <span class="absolute top-2 right-2 text-[10px] font-bold bg-white/90 text-slate-700 px-2 py-0.5 rounded-md">
          851x1200 px
        </span>
      </div>
      <div class="p-4 space-y-2">
        <h3 class="text-xs font-bold text-slate-900 truncate" title="auto_julio_2023.jpg">
          auto_julio_2023.jpg
        </h3>
        <div class="text-[11px] text-slate-500 flex items-center justify-between">
          <span>12/07/2023</span>
          <span class="font-mono">134.78 KB</span>
        </div>
        <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
          <button
            onclick="navigator.clipboard.writeText('/files/auto_julio_2023.jpg'); alert('URL copiada al portapapeles!');"
            class="w-full text-center text-xs font-semibold text-unlu-green hover:bg-emerald-50 py-1.5 rounded-lg border border-emerald-200 transition-colors"
          >
            Copiar Link
          </button>
        </div>
      </div>
    </div>

    <!-- Archivo 6: Logo Transparente PNG -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition-all overflow-hidden group">
      <div class="h-32 bg-slate-900 flex items-center justify-center relative overflow-hidden">
        <img src="/escudo.svg" alt="" class="w-12 h-12" />
        <span class="absolute top-2 right-2 text-[10px] font-bold bg-slate-800 text-white px-2 py-0.5 rounded-md">
          100x100 px
        </span>
      </div>
      <div class="p-4 space-y-2">
        <h3 class="text-xs font-bold text-slate-900 truncate" title="logo-transparente.png">
          logo-transparente.png
        </h3>
        <div class="text-[11px] text-slate-500 flex items-center justify-between">
          <span>23/06/2016</span>
          <span class="font-mono">17.90 KB</span>
        </div>
        <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
          <button
            onclick="navigator.clipboard.writeText('/files/logo-transparente.png'); alert('URL copiada al portapapeles!');"
            class="w-full text-center text-xs font-semibold text-unlu-green hover:bg-emerald-50 py-1.5 rounded-lg border border-emerald-200 transition-colors"
          >
            Copiar Link
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  const dragZone = document.getElementById('drag-drop-zone');
  const fileInput = document.getElementById('file-input-hidden') as HTMLInputElement | null;
  const triggerBtn = document.getElementById('trigger-upload-modal-btn');

  if (dragZone && fileInput) {
    dragZone.addEventListener('click', () => fileInput.click());
    
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        alert(`¡Simulación exitosa! Se han recibido ${fileInput.files.length} archivo(s). Quedarán disponibles en el servidor.`);
      }
    });
  }

  if (triggerBtn && fileInput) {
    triggerBtn.addEventListener('click', () => fileInput.click());
  }
</script>
